{
	admin off
}

:8080 {
	root * /srv
	encode zstd gzip
	header {
		X-Robots-Tag "noindex, nofollow"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
	header /_astro/* Cache-Control "public, max-age=31536000, immutable"
	try_files {path} {path}/index.html
	file_server
	handle_errors {
		rewrite * /404.html
		file_server
	}
}
