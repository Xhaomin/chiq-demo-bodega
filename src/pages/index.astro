  const vista = { x: va.x + (vb.x - va.x) * kv, y: va.y + (vb.y - va.y) * kv, s: va.s + (vb.s - va.s) * kv,
    ry: (Math.sin(t / 4200) * 0.35 + ratonS[0] * 0.6) * giro, rx: ratonS[1] * 0.26 * giro };
