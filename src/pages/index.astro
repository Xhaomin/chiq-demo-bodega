---
// Los datos de la bodega son ficticios; las formas se calculan con ellos en el navegador.
import B from '../data/bodega.json';

// Con separador también en las cifras de cuatro dígitos (4.200), como el resto de la página.
const miles = (n: number) => n.toLocaleString('es-ES', { useGrouping: 'always' } as Intl.NumberFormatOptions);
const JSON_BODEGA = JSON.stringify(B).replace(/</g, '\\u003c');
const enLetra = (n: number, femenino = false) => [femenino ? 'Una' : 'Un', 'Dos', 'Tres', 'Cuatro', 'Cinco', 'Seis'][n - 1] ?? String(n);
const CUANTAS = enLetra(B.terruno.parcelas.length, true);
const V = B.vinos[0];
const DESDE = Math.min(...B.terruno.parcelas.map((p) => p.plantada));
// El carrusel final: una imagen por sección que lleva a su escena. Las fotos son de Unsplash (provisionales y sin
// personas); la de la cata es el render de su rueda de moléculas.
const unsplash = (id: string) => `https://images.unsplash.com/photo-${id}?w=900&h=1100&fit=crop&q=70`;
const GALERIA = [
  { paso: 'Descubre', titulo: 'La ladera', ancla: '#descubre', imagen: unsplash('1767731415567-3acdb94de881'), texto: `${CUANTAS} parcelas al ${B.terruno.orientacion}, entre ${B.terruno.altitud_min} y ${B.terruno.altitud_max} metros.` },
  { paso: 'Prueba', titulo: 'La cata', ancla: '#prueba', imagen: '/img/cata-3d.webp', claro: true, texto: `${enLetra(B.vinos.length)} vinos y lo que hay en cada copa.` },
  { paso: 'Visita', titulo: 'La bodega', ancla: '#visita', imagen: unsplash('1561906814-23da9a8bfee0'), texto: `Visitas ${B.visitas.dias}, con ${B.visitas.cata}.` },
  { paso: 'Llévatelo y quédate', titulo: 'Tienda y club', ancla: '#tienda', imagen: unsplash('1554230561-31bdc707b537'), texto: 'Cada vino con su ficha, y para los socios, cada añada antes que nadie.' },
];
// El menú: las secciones de una web de bodega, que llevan a su parte de la home.
const MENU = [['/', 'Historia'], ['#prueba', 'Los vinos'], ['#visita', 'Visitas'], ['#tienda', 'Tienda'], ['#club', 'Club']];
// El recorrido del cliente: un paso por escena.
const PASOS = [['descubre', 'Descubre'], ['prueba', 'Prueba'], ['visita', 'Visita'], ['llevatelo', 'Llévatelo'], ['quedate', 'Quédate']];
---
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Bodega Ejemplo · demo de chiq.es</title>
<meta name="robots" content="noindex, nofollow">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;1,6..72,300;1,6..72,400;1,6..72,500&family=Inter+Tight:wght@400;500&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style is:global>
:root{--papel:#f2ede5;--ink:#1a1414;--tinta2:rgba(26,20,20,.7);--tinta3:rgba(26,20,20,.45);--vino:#7a1a3e;--linea:rgba(26,20,20,.1);--hud:rgba(26,20,20,.45)}
*{box-sizing:border-box;margin:0;padding:0}
html{background:var(--papel)}
body{color:var(--ink);font-family:'Inter Tight',system-ui,sans-serif;-webkit-font-smoothing:antialiased;overflow-x:hidden}
body.oscuro{--ink:#f4efe8;--linea:rgba(244,239,232,.3);--hud:rgba(244,239,232,.72)}
.mono{font-family:'JetBrains Mono',ui-monospace,monospace;font-size:10.5px;letter-spacing:.2em;text-transform:uppercase}
/* el vuelo: la foto del viñedo, que se acerca hasta las uvas */
#fotos{position:fixed;inset:0;z-index:1;overflow:hidden;background:#1a1210}
#fotos img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;will-change:transform,opacity,filter;transform-origin:62% 72%}
#fotos .sombra{position:absolute;inset:0;background:radial-gradient(ellipse 70% 45% at 50% 50%,rgba(10,6,6,.32),transparent 75%),linear-gradient(180deg,rgba(10,6,6,.5),rgba(10,6,6,.18) 45%,rgba(10,6,6,.55))}
#escarcha{position:fixed;inset:0;z-index:2;pointer-events:none;-webkit-backdrop-filter:blur(var(--b,0px)) saturate(1.2);backdrop-filter:blur(var(--b,0px)) saturate(1.2);background:rgba(242,237,229,var(--a,0))}
canvas#gl{position:fixed;inset:0;width:100vw;height:100vh;z-index:3;pointer-events:none}
#etiquetas{position:fixed;inset:0;pointer-events:none;z-index:4}
header{position:fixed;top:0;left:0;right:0;z-index:20;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;padding:20px clamp(18px,4vw,56px);border-bottom:1px solid transparent;transition:background .6s,border-color .6s}
body:not(.oscuro) header{background:var(--papel);border-color:var(--linea)}
.logo{font-family:'Newsreader',serif;font-style:italic;font-weight:300;font-size:26px;letter-spacing:-.01em;color:var(--ink);text-decoration:none;transition:color .6s}
.recorrido{display:flex;gap:28px}
.recorrido span{color:var(--hud);padding-bottom:4px;border-bottom:1px solid transparent;transition:color .6s,border-color .6s}
.recorrido span.on{color:var(--vino);border-color:var(--vino)}
.burger{justify-self:end;width:42px;height:42px;border-radius:50%;border:1px solid var(--linea);display:grid;place-items:center;cursor:pointer;background:transparent;transition:border-color .6s}
.burger i{display:block;width:14px;height:1px;background:var(--ink);box-shadow:0 5px 0 var(--ink);transform:translateY(-2px);transition:background .6s,box-shadow .6s}
.nota{position:fixed;z-index:30;left:50%;transform:translateX(-50%);bottom:22px;color:var(--hud);pointer-events:none;transition:color .6s;white-space:nowrap}
main{position:relative;z-index:10}
#vuelo{height:520vh;position:relative}
.pin{position:sticky;top:0;height:100vh;overflow:hidden}
.beat{position:absolute;inset:0;display:flex;flex-direction:column;justify-content:center;padding:0 clamp(18px,8vw,140px);will-change:opacity,transform}
.beat1{align-items:center;text-align:center;color:#f4efe8}
.beat1 h1{font-family:'Newsreader',serif;font-weight:300;font-size:clamp(50px,8.4vw,140px);line-height:.93;letter-spacing:-.03em;max-width:13ch;text-shadow:0 2px 40px rgba(0,0,0,.25)}
.beat1 h1 em{font-style:italic;color:#f0b9cb}
.beat1 .cue{position:absolute;bottom:64px;left:50%;transform:translateX(-50%);color:rgba(244,239,232,.8)}
.beat1 .cue::after{content:'';display:block;width:1px;height:48px;background:#f4efe8;margin:12px auto 0;animation:cue 2.2s cubic-bezier(.7,0,.2,1) infinite}
@keyframes cue{0%{transform:scaleY(0);transform-origin:top}45%{transform:scaleY(1);transform-origin:top}55%{transform:scaleY(1);transform-origin:bottom}100%{transform:scaleY(0);transform-origin:bottom}}
.beat2{align-items:flex-start}
.beat2 .texto{max-width:34rem}
.medio{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);color:#f4efe8;text-align:center;opacity:0}
.medio .mono{color:rgba(244,239,232,.85);font-size:12px}
/* las escenas: cada una fija mientras dura su sección */
section.escena{position:relative}
.fijo{position:sticky;top:0;height:100vh;display:flex;align-items:center;padding:90px clamp(30px,8vw,140px) 30px}
.texto{max-width:34rem}
.kicker{color:var(--tinta3)}
h1.titulo,h2{font-family:'Newsreader',serif;font-weight:300;letter-spacing:-.025em;line-height:.95;color:#1a1414}
h1.titulo{font-size:clamp(56px,7.2vw,124px);margin:20px 0 24px}
h2{font-size:clamp(48px,5.6vw,98px);margin:18px 0 22px}
h1.titulo em,h2 em{font-style:italic;color:var(--vino)}
p.cuerpo{font-size:17px;line-height:1.72;color:var(--tinta2);max-width:34ch}
.vino-nombre{font-family:'Newsreader',serif;font-style:italic;font-weight:300;font-size:clamp(34px,3.4vw,54px);color:var(--vino);line-height:1;margin:6px 0 10px}
.vino-tipo,.ficha{color:var(--tinta3)}
.precio{font-family:'Newsreader',serif;font-weight:300;font-size:64px;line-height:1;margin:16px 0 18px;color:#1a1414}
.pronto{display:inline-block;margin-top:24px;padding:12px 20px;border:1px solid var(--linea);border-radius:999px;color:var(--tinta3)}
.tag{display:block;margin-top:18px;color:var(--tinta3);font-size:9.5px}
.cta{display:inline-flex;align-items:center;gap:14px;margin-top:28px;font-size:15px;color:#1a1414;text-decoration:none}
.cta .ar{width:46px;height:46px;border-radius:50%;border:1px solid #1a1414;display:grid;place-items:center;font-size:16px;transition:all .5s cubic-bezier(.7,0,.2,1)}
.cta:hover .ar{background:var(--vino);border-color:var(--vino);color:#fff;transform:rotate(-45deg)}
.texto>*{opacity:0;transform:translateY(14px);transition:opacity 1.3s,transform 1.4s cubic-bezier(.16,.84,.24,1)}
.in .texto>*{opacity:1;transform:none}
.in .texto>*:nth-child(2){transition-delay:.12s}.in .texto>*:nth-child(3){transition-delay:.24s}.in .texto>*:nth-child(4){transition-delay:.36s}.in .texto>*:nth-child(5){transition-delay:.48s}.in .texto>*:nth-child(6){transition-delay:.6s}
.datos{list-style:none;margin:16px 0 0;display:grid;gap:6px;color:var(--tinta3);max-width:46ch}
.datos b{display:inline-block;min-width:7ch;color:var(--vino);font-weight:500;margin-right:10px}
.con-etiquetas .datos{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);clip-path:inset(50%);white-space:nowrap}
/* cifras sobre las formas, proyectadas con la misma cámara que las moléculas */
.et{position:absolute;left:0;top:0;text-align:center;white-space:nowrap;opacity:0;will-change:transform,opacity}
.et.izq{text-align:left}
.et b,.et span{text-shadow:0 0 10px var(--papel),0 0 3px var(--papel),0 0 1px var(--papel)}
.et b{display:block;font-family:'Newsreader',serif;font-weight:400;font-style:italic;font-size:clamp(18px,1.6vw,26px);line-height:1;color:#1a1414}
.et span{display:block;font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--tinta3);margin-top:5px}
/* el carrusel final */
.gal{height:320vh;position:relative}
.gal-in{position:sticky;top:0;height:100vh;overflow:hidden;display:flex;flex-direction:column;justify-content:center}
.gal-head{padding:0 clamp(18px,8vw,140px);display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:40px}
.gal-head h3{font-family:'Newsreader',serif;font-weight:300;font-size:clamp(36px,4.4vw,66px);letter-spacing:-.025em;line-height:1;color:#1a1414}
.track{display:flex;gap:26px;padding:0 clamp(18px,8vw,140px);will-change:transform}
.panel{flex:0 0 min(380px,78vw);height:min(62vh,520px);border-radius:4px;padding:30px;display:flex;flex-direction:column;justify-content:flex-end;position:relative;overflow:hidden;color:#f4efe8;text-decoration:none;box-shadow:0 40px 80px -40px rgba(20,16,17,.45);background:#1a1210}
.panel .ph{position:absolute;inset:0;background-size:cover;background-position:center;transition:transform 1.4s cubic-bezier(.16,.84,.24,1)}
.panel::after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,rgba(20,14,14,.25),rgba(20,14,14,0) 30%,rgba(20,14,14,.15) 50%,rgba(20,14,14,.82))}
.panel:hover .ph{transform:scale(1.06)}
.panel>*:not(.ph){position:relative;z-index:1}
.panel h4{font-family:'Newsreader',serif;font-weight:300;font-size:50px;letter-spacing:-.025em;line-height:1;margin-bottom:12px}
.panel p{font-size:15px;color:rgba(244,239,232,.85);max-width:28ch;line-height:1.5}
.panel .idx{position:absolute;left:30px;top:30px;color:rgba(244,239,232,.85)}
.gal-head h3 em{font-style:italic;color:var(--vino)}
.panel.claro{background:#f2ede5;color:#1a1414;box-shadow:0 40px 80px -40px rgba(20,16,17,.3),inset 0 0 0 1px rgba(26,20,20,.08)}
.panel.claro::after{background:linear-gradient(180deg,rgba(242,237,229,0) 58%,rgba(242,237,229,.94) 80%)}
.panel.claro p{color:rgba(26,20,20,.7)}.panel.claro .idx{color:rgba(26,20,20,.5)}
footer{position:relative;z-index:10;padding:140px clamp(18px,8vw,140px) 40px;display:grid;gap:56px;background:var(--papel);color:#1a1414}
footer .big{font-family:'Newsreader',serif;font-weight:300;font-size:clamp(40px,6vw,96px);letter-spacing:-.03em;line-height:.95;max-width:14ch}
footer .big em{font-style:italic;color:var(--vino)}
footer .cols{display:flex;flex-wrap:wrap;gap:40px 80px;justify-content:space-between;border-top:1px solid rgba(20,16,17,.12);padding-top:28px;color:var(--tinta3)}
footer .cols a{color:#1a1414;text-decoration:none;display:block;font-size:14px;line-height:2}
footer .pie-t{display:block;font-size:14px;line-height:1.5;opacity:.75;max-width:30ch;text-transform:none;letter-spacing:0;font-family:'Inter Tight',sans-serif}
#pre{position:fixed;inset:0;z-index:60;background:#141011;color:#f4efe8;display:grid;place-items:center;transition:opacity .9s .2s,visibility .9s .2s}
#pre.out{opacity:0;visibility:hidden}
#menu{position:fixed;inset:0;z-index:40;background:#141011;color:#f4efe8;clip-path:circle(0% at calc(100% - 62px) 43px);transition:clip-path 1s cubic-bezier(.7,0,.2,1);display:flex;flex-direction:column;justify-content:center;padding:0 clamp(18px,8vw,140px)}
#menu.open{clip-path:circle(160% at calc(100% - 62px) 43px)}
#menu a{font-family:'Newsreader',serif;font-weight:300;font-size:clamp(42px,6.4vw,96px);color:#f4efe8;text-decoration:none;line-height:1.08;display:flex;gap:26px;align-items:baseline;transition:color .3s,padding .5s cubic-bezier(.16,.84,.24,1)}
#menu a:hover{color:#d88aa6;padding-left:18px}
#menu a small{font-family:'JetBrains Mono',monospace;font-size:12px;color:#8d8580}
#menu .seal{position:absolute;bottom:32px;left:clamp(18px,8vw,140px);color:#8d8580}
#menu .close{position:absolute;top:22px;right:clamp(18px,4vw,56px);color:#f4efe8;background:none;border:1px solid #4a4244;border-radius:999px;padding:10px 18px;cursor:pointer}
@media (min-width:861px) and (max-width:1100px){
  .recorrido{gap:14px}
  .fijo,.beat{padding-left:clamp(24px,6vw,72px)}
  .texto,.beat2 .texto{max-width:21rem}
  h1.titulo{font-size:62px}h2{font-size:54px}p.cuerpo{font-size:15px}
}
@media (max-width:860px){
  header{grid-template-columns:1fr auto;padding:14px 18px}.recorrido{display:none}
  .nota{display:none}
  .fijo{align-items:flex-start;padding:15vh 24px 0}
  .beat2{justify-content:flex-start;padding-top:15vh}
  h1.titulo{font-size:48px;margin:16px 0}h2{font-size:44px;margin:14px 0}
  p.cuerpo{font-size:15px}.precio{font-size:46px;margin:8px 0}
  .vino-nombre{font-size:32px}
  #tienda p.cuerpo,.tag{display:none}
  .pronto{margin-top:12px;padding:9px 16px}
  .et b{font-size:16px}.et span{font-size:8.5px}
}
</style>
</head>
<body class="oscuro">
<div id="pre"><div class="mono" id="preTxt">bodega ░░░░░░░░░░░░ 000</div></div>
<div id="fotos" aria-hidden="true">
  <img id="f1" src="https://images.unsplash.com/photo-1567072629554-20e689de2400?w=2400&q=75" alt="">
  <img id="f2" src="https://images.unsplash.com/photo-1537640538966-79f369143f8f?w=2600&q=75" alt="" style="opacity:0">
  <div class="sombra" id="sombra"></div>
</div>
<div id="escarcha"></div>
<canvas id="gl" aria-hidden="true"></canvas>
<div id="etiquetas" aria-hidden="true"></div>

<header>
  <a class="logo" href="/">{B.nombre}</a>
  <nav class="recorrido mono" aria-label="Tu recorrido">{PASOS.map(([id, nombre]) => <span data-paso={id}>{nombre}</span>)}</nav>
  <button class="burger" id="burger" aria-label="Abrir menú"><i></i></button>
</header>
<div class="nota mono">Demo de chiq.es · Astro y motor propio WebGL2 (<span id="motorKB">…</span>)</div>

<main>
  <section id="vuelo">
    <div class="pin">
      <div class="beat beat1" id="beat1">
        <p class="mono" style="color:rgba(244,239,232,.8);margin-bottom:34px">Ladera {B.terruno.orientacion} · {B.terruno.altitud_min}–{B.terruno.altitud_max} metros</p>
        <h1>Cada botella empieza <em>en la cepa.</em></h1>
        <div class="cue mono">Scroll</div>
      </div>
      <div class="medio" id="medio"><span class="mono">Del campo a la copa</span></div>
      <div class="beat beat2" id="beat2" style="opacity:0"><div class="texto">
        <p class="kicker mono">Viñas desde {DESDE}</p>
        <h1 class="titulo">{CUANTAS} parcelas, <em>un vino.</em></h1>
        <p class="cuerpo">La historia de la bodega, contada como se hace el vino. Despacio y desde el suelo.</p>
      </div></div>
    </div>
  </section>

  <section class="escena" id="descubre" data-paso="descubre" data-pasos="2" style="height:190vh"><div class="fijo"><div class="texto">
    <p class="kicker mono">01 · Descubre</p>
    <h2>La <em>ladera.</em></h2>
    <p class="cuerpo">{CUANTAS} parcelas orientadas al {B.terruno.orientacion}, entre {B.terruno.altitud_min} y {B.terruno.altitud_max} metros, sobre suelo {B.terruno.suelo}. Cada una se vendimia por separado.</p>
    <ul class="datos mono">{B.terruno.parcelas.map((p) => <li><b>{p.nombre}</b>{p.variedad} · plantada en {p.plantada}</li>)}</ul>
  </div></div></section>
  <section class="escena" id="prueba" data-paso="prueba" data-pasos={B.vinos.length} style={`height:${B.vinos.length * 80 + 30}vh`}><div class="fijo"><div class="texto">
    <p class="kicker mono">02 · Prueba</p>
    <h2>Lo que hay <em>en la copa.</em></h2>
    <p class="vino-nombre" id="vinoNombre" aria-live="polite">{B.vinos[0].nombre}</p>
    <p class="vino-tipo mono" id="vinoTipo">{B.vinos[0].tipo}</p>
    <ul class="datos mono">{B.vinos.map((v) => <li><b>{v.nombre}</b>{B.aromas.map((a, i) => `${a} ${v.cata[i]}`).join(' · ')}</li>)}</ul>
    <span class="tag mono">Cata del 0 al 10</span>
  </div></div></section>
  <section class="escena" id="visita" data-paso="visita" style="height:170vh"><div class="fijo"><div class="texto">
    <p class="kicker mono">03 · Visita</p>
    <h2>Ven a <em>vernos.</em></h2>
    <p class="cuerpo">Hormigón, luz y una banda de lamas que sube con la ladera. Visitas {B.visitas.dias}, con {B.visitas.cata}.</p>
    <span class="pronto mono">Reservas · próximamente</span>
    <ul class="datos mono"><li><b>{miles(B.visitas.al_anio)}</b>visitas al año</li><li><b>Club</b>1 de cada {B.visitas.socio_uno_de_cada} visitantes se hace socio</li></ul>
  </div></div></section>
  <section class="escena" id="tienda" data-paso="llevatelo" style="height:170vh"><div class="fijo"><div class="texto">
    <p class="kicker mono">04 · Llévatelo</p>
    <h2>Llévatelo <em>a casa.</em></h2>
    <p class="ficha mono">{V.nombre} · {V.tipo} · {V.formato}</p>
    <p class="precio">{V.precio}</p>
    <p class="cuerpo">La ficha vive en PrestaShop y la web la lee por su API. Así también un asistente de IA entiende cada vino.</p>
    <span class="pronto mono">Tienda · próximamente</span>
    <ul class="datos mono"><li><b>Precio</b>{V.precio}</li><li><b>Stock</b>{miles(V.stock)} botellas</li></ul>
  </div></div></section>
  <section class="escena" id="club" data-paso="quedate" style="height:170vh"><div class="fijo"><div class="texto">
    <p class="kicker mono">05 · Quédate</p>
    <h2>El sello <em>de la casa.</em></h2>
    <p class="cuerpo">Los socios del club reciben cada añada antes que nadie y una visita al año. 1 de cada {B.visitas.socio_uno_de_cada} visitantes se hace socio.</p>
    <span class="pronto mono">Club · próximamente</span>
  </div></div></section>

  <section class="gal" id="gal">
    <div class="gal-in">
      <div class="gal-head"><h3>El <em>recorrido.</em></h3><span class="mono" style="color:var(--tinta3)">Desliza →</span></div>
      <div class="track" id="track">{GALERIA.map((g, k) => (
        <a class={g.claro ? 'panel claro' : 'panel'} href={g.ancla}><div class="ph" style={`background-image:url(${g.imagen})`}></div>
          <span class="idx mono">/0{k + 1} · {g.paso}</span><h4>{g.titulo}</h4><p>{g.texto}</p></a>))}
      </div>
    </div>
  </section>
</main>

<footer>
  <p class="big">Cada botella empieza <em>en la cepa.</em></p>
  <div class="cols">
