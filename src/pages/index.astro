}
function vueloVisual(y) {
  const p = clamp(y / (vuelo.offsetTop + vuelo.offsetHeight - innerHeight));
  // Un solo zoom a ritmo constante: la primera foto se acerca y se desenfoca; la segunda llega desenfocada, se enfoca y
  // sigue acercándose al mismo ritmo, como si la cámara se metiera entre las vides.
  const r = Math.log(ESCALA_FOTO) / (P_FIN - P_CRUCE), L = r * Math.min(p, P_FIN);
  f1.style.transform = `scale(${Math.exp(L).toFixed(4)})`;
  f1.style.opacity = 1 - suave(tramo(p, 0.32, 0.46));
  f1.style.filter = `blur(${(suave(tramo(p, 0.24, 0.44)) * 10).toFixed(2)}px)`;
  f2.style.opacity = suave(tramo(p, 0.32, 0.46)) * (1 - suave(tramo(p, 0.74, 0.86)));
  f2.style.transform = `scale(${Math.exp(Math.max(0, L - r * P_CRUCE)).toFixed(4)})`;
  f2.style.filter = `blur(${((1 - suave(tramo(p, 0.36, 0.58))) * 12).toFixed(2)}px)`;
  const e1 = Math.sin(Math.PI * tramo(p, 0.34, 0.5)), e2 = tramo(p, 0.72, 0.9);
  escarcha.style.setProperty('--b', (e1 * 4 + e2 * 14) + 'px');
  escarcha.style.setProperty('--a', (e1 * 0.12 + suave(e2) * 1).toFixed(3));
  sombra.style.opacity = 1 - tramo(p, 0.6, 0.8);
  fotos.style.visibility = p >= 0.999 ? 'hidden' : 'visible';
  b1.style.opacity = 1 - suave(tramo(p, 0.08, 0.22)); b1.style.transform = `translateY(${-tramo(p, 0.05, 0.25) * 60}px)`;
  medio.style.opacity = Math.sin(Math.PI * tramo(p, 0.5, 0.74)) * 0.95;
  b2.style.opacity = suave(tramo(p, 0.9, 1)); b2.style.transform = `translateY(${(1 - tramo(p, 0.9, 1)) * 30}px)`;
  b2.classList.toggle('in', p > 0.9);
  uFoto = 1 - suave(tramo(p, 0.8, 0.97));
  const osc = p < 0.84; if (osc !== oscuro) { oscuro = osc; document.body.classList.toggle('oscuro', osc); }
