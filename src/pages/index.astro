<script is:inline type="module">
/* ============================================================================================
   Motor propio de partículas en WebGL2 (sin Three.js). Mismo shader, mismas formas y mismo
   comportamiento que la maqueta con Three.js; solo cambia la «fontanería» con la tarjeta gráfica.
   ============================================================================================ */
const clamp = (v, a = 0, b = 1) => Math.min(b, Math.max(a, v));
const tramo = (p, a, b) => clamp((p - a) / (b - a));
const suave = (x) => x * x * (3 - 2 * x);

/* ---------- texto ---------- */
document.querySelectorAll('.split').forEach((el) => {
  const frag = document.createDocumentFragment(); let k = 0;
  el.childNodes.forEach((n) => n.textContent.split(/(\s+)/).forEach((w) => {
    if (!w) return;
    if (/^\s+$/.test(w)) { frag.appendChild(document.createTextNode(' ')); return; }
    const o = document.createElement('span'); o.className = 'w';
    const i = document.createElement(n.nodeType === 1 ? n.tagName.toLowerCase() : 'span');
    i.textContent = w; i.style.transitionDelay = (k++ * 0.055) + 's'; o.appendChild(i); frag.appendChild(o);
  }));
  el.innerHTML = ''; el.appendChild(frag);
});
const io = new IntersectionObserver((es) => es.forEach((e) => e.isIntersecting && e.target.classList.add('in')), { threshold: 0.35 });
document.querySelectorAll('section.scene').forEach((s) => io.observe(s));
const menu = document.getElementById('menu');
document.getElementById('burger').onclick = () => menu.classList.add('open');
document.getElementById('close').onclick = () => menu.classList.remove('open');
const GLIFOS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789/_·#';
function descifrar(el, texto) {
  const ini = performance.now();
  const paso = (t) => { const p = Math.min(1, (t - ini) / 520), fijas = Math.floor(p * texto.length);
    el.textContent = texto.split('').map((c, i) => (i < fijas || c === ' ') ? c : GLIFOS[(Math.random() * GLIFOS.length) | 0]).join('');
    if (p < 1) requestAnimationFrame(paso); };
  requestAnimationFrame(paso);
}

/* ---------- formas (idénticas a la maqueta con Three.js) ---------- */
const N = 16000, R = Math.random;
const esfera = (c, r) => { const u = R() * 2 - 1, th = R() * Math.PI * 2, s = Math.sqrt(1 - u * u); return [c[0] + r * s * Math.cos(th), c[1] + r * u, c[2] + r * s * Math.sin(th)]; };
function racimo() {
  const a = new Float32Array(N * 3), cs = [], filas = [6, 6, 6, 5, 5, 4, 3, 2, 1]; let y = 1.35;
  filas.forEach((c, f) => { const rad = 0.16 * c; for (let k = 0; k < c; k++) { const an = k / c * Math.PI * 2 + f * 0.7; cs.push([Math.cos(an) * rad, y + (R() - .5) * .06, Math.sin(an) * rad]); } if (c > 2) cs.push([0, y, 0]); y -= 0.31; });
  for (let i = 0; i < N; i++) { if (i < N * 0.035) { const t = R(); a.set([0.05 * Math.sin(t * 6) + t * 0.12, 1.5 + t * 0.75, 0], i * 3); continue; } a.set(esfera(cs[i % cs.length], 0.2), i * 3); }
  return a;
}
function probetas() {
  const a = new Float32Array(N * 3), xs = [-1.15, 0, 1.15], lv = [.82, .62, .38];
  for (let i = 0; i < N; i++) { const k = i % 3, x = xs[k], r = 0.36, th = R() * Math.PI * 2;
    if (R() < 0.5) a.set([x + Math.cos(th) * r, -1.5 + R() * 3, Math.sin(th) * r], i * 3);
    else { const rr = Math.sqrt(R()) * r * 0.9; a.set([x + Math.cos(th) * rr, -1.5 + R() * 3 * lv[k], Math.sin(th) * rr], i * 3); } }
  return a;
}
function globo() {
  const a = new Float32Array(N * 3), r0 = 1.7;
  for (let i = 0; i < N; i++) { let p;
    if (R() < 0.45) { const an = (R() * 9) | 0, t = R() * Math.PI * 2;
      if (R() < 0.5) { const lat = (an / 8 - 0.5) * Math.PI; p = [Math.cos(lat) * Math.cos(t) * r0, Math.sin(lat) * r0, Math.cos(lat) * Math.sin(t) * r0]; }
      else { const lon = an / 9 * Math.PI; p = [Math.cos(t) * Math.cos(lon) * r0, Math.sin(t) * r0, Math.cos(t) * Math.sin(lon) * r0]; } }
    else p = esfera([0, 0, 0], r0 * (0.97 + R() * 0.06));
    a.set(p, i * 3); }
  return a;
}
function red() {
  const a = new Float32Array(N * 3), hubs = [], C = [0, 0, 0];
  for (let k = 0; k < 5; k++) { const t = k / 5 * Math.PI * 2 - Math.PI / 2; hubs.push([Math.cos(t) * 2, Math.sin(t) * 1.35, Math.sin(t * 2) * 0.7]); }
  const ar = []; hubs.forEach((h, k) => { ar.push([h, C]); ar.push([h, hubs[(k + 1) % 5]]); }); const nodos = [C, ...hubs];
  for (let i = 0; i < N; i++) {
    if (R() < 0.6) { const e = ar[i % ar.length], t = R(); a.set([0, 1, 2].map((d) => e[0][d] + (e[1][d] - e[0][d]) * t + (R() - .5) * .035), i * 3); }
    else { const nd = nodos[i % nodos.length]; a.set(esfera(nd, nd === C ? 0.46 : 0.22), i * 3); } }
  return a;
}
function botella() {
  const a = new Float32Array(N * 3), perfil = (y) => y < 0.3 ? 0.64 : y < 0.95 ? 0.21 + 0.43 * (0.5 + 0.5 * Math.cos((y - 0.3) / 0.65 * Math.PI)) : (y > 1.6 ? 0.25 : 0.21);
  for (let i = 0; i < N; i++) { const th = R() * Math.PI * 2;
    if (R() < 0.06) { const rr = Math.sqrt(R()) * 0.64; a.set([Math.cos(th) * rr, -1.6, Math.sin(th) * rr], i * 3); continue; }
    const y = -1.6 + R() * 3.35, r = perfil(y); a.set([Math.cos(th) * r, y, Math.sin(th) * r], i * 3); }
  return a;
}
function web() {
  const a = new Float32Array(N * 3), W = 3.8, H = 2.4, ry = -0.45, rx = 0.12;
  const bl = [[-1.7, 0.72, 1.5, 0.55], [-0.05, 0.72, 1.75, 0.55], [-1.7, 0.02, 1.0, 1.05], [-0.55, 0.02, 1.0, 1.05], [0.6, 0.02, 1.1, 1.05]];
  for (let i = 0; i < N; i++) { let x, y; const p = R();
    if (p < 0.3) { const t = R() * 2 * (W + H); if (t < W) { x = -W / 2 + t; y = H / 2; } else if (t < W + H) { x = W / 2; y = H / 2 - (t - W); } else if (t < 2 * W + H) { x = W / 2 - (t - W - H); y = -H / 2; } else { x = -W / 2; y = -H / 2 + (t - 2 * W - H); } }
    else if (p < 0.38) { x = -W / 2 + R() * W; y = H / 2 - 0.3; }
    else if (p < 0.42) { const d = (R() * 3) | 0, th = R() * Math.PI * 2; x = -W / 2 + 0.22 + d * 0.17 + Math.cos(th) * 0.05; y = H / 2 - 0.15 + Math.sin(th) * 0.05; }
    else { const b = bl[i % bl.length]; x = b[0] + R() * b[2]; y = b[1] - R() * b[3]; }
    const z = (R() - .5) * 0.05, x1 = x * Math.cos(ry) + z * Math.sin(ry), z1 = -x * Math.sin(ry) + z * Math.cos(ry);
    a.set([x1, y * Math.cos(rx) - z1 * Math.sin(rx), y * Math.sin(rx) + z1 * Math.cos(rx)], i * 3); }
  return a;
}


/* ---------- formas calculadas con los datos de la bodega (ficticios) ---------- */
const B = JSON.parse(document.getElementById('datos-bodega').textContent);
/** Una probeta por añada, llena en proporción a sus botellas (la más llena es la añada con más botellas). */
function probetasDe(anadas) {
  const a = new Float32Array(N * 3), n = anadas.length, max = Math.max(...anadas.map((x) => x.botellas));
  const xs = anadas.map((_, k) => (k - (n - 1) / 2) * 1.1), lv = anadas.map((x) => 0.9 * x.botellas / max);
  for (let i = 0; i < N; i++) { const k = i % n, x = xs[k], r = 0.34, th = R() * Math.PI * 2;
    if (R() < 0.45) a.set([x + Math.cos(th) * r, -1.5 + R() * 3, Math.sin(th) * r], i * 3);
    else { const rr = Math.sqrt(R()) * r * 0.9; a.set([x + Math.cos(th) * rr, -1.5 + R() * 3 * lv[k], Math.sin(th) * rr], i * 3); } }
  return a;
}
/** Globo tenue con un grupo por país, en su latitud y longitud, con partículas en proporción a sus ventas. */
function globoDe(mercados) {
  const a = new Float32Array(N * 3), r0 = 1.7, rad = Math.PI / 180, lon0 = mercados[0].lon;
  const pts = mercados.map((m) => { const la = m.lat * rad, lo = (m.lon - lon0) * rad;
    return { c: [Math.cos(la) * Math.sin(lo) * r0, Math.sin(la) * r0, Math.cos(la) * Math.cos(lo) * r0], w: m.pct }; });
  const total = pts.reduce((s, p) => s + p.w, 0); let acum = 0; const cortes = pts.map((p) => (acum += p.w / total));
  for (let i = 0; i < N; i++) { let p;
    if (R() < 0.4) p = esfera([0, 0, 0], r0 * (0.98 + R() * 0.04));
    else { const u = R(), q = pts[Math.max(0, cortes.findIndex((c) => u <= c))]; p = esfera(q.c, (0.06 + 0.42 * Math.sqrt(q.w / total)) * Math.cbrt(R())); }
    a.set(p, i * 3); }
  return a;
}
/** El cliente en el centro y un nodo por canal, con tamaño y partículas en proporción a lo que factura. */
function redDe(canales) {
  const a = new Float32Array(N * 3), C = [0, 0, 0], n = canales.length, total = canales.reduce((s, c) => s + c.pct, 0);
  const hubs = canales.map((c, k) => { const t = k / n * Math.PI * 2 - Math.PI / 2; return { p: [Math.cos(t) * 2, Math.sin(t) * 1.35, Math.sin(t * 2) * 0.5], w: c.pct / total }; });
  const ar = []; hubs.forEach((h, k) => { ar.push([h.p, C]); ar.push([h.p, hubs[(k + 1) % n].p]); });
  let acum = 0; const cortes = hubs.map((h) => (acum += h.w));
  for (let i = 0; i < N; i++) { const u = R();
    if (u < 0.35) { const e = ar[i % ar.length], t = R(); a.set([0, 1, 2].map((d) => e[0][d] + (e[1][d] - e[0][d]) * t + (R() - .5) * .035), i * 3); }
    else if (u < 0.45) a.set(esfera(C, 0.3 * Math.cbrt(R())), i * 3);
    else { const v = R(), h = hubs[Math.max(0, cortes.findIndex((c) => v <= c))]; a.set(esfera(h.p, (0.12 + 0.55 * Math.sqrt(h.w)) * Math.cbrt(R())), i * 3); } }
  return a;
}
/** Rueda de aromas: una porción por aroma, que llega hasta su intensidad (el borde es el 10). */
function ruedaDe(aromas) {
  const a = new Float32Array(N * 3), n = aromas.length, Rm = 1.9, giro = 0.35, sector = Math.PI * 2 / n;
  for (let i = 0; i < N; i++) { let x, y; const u = R();
    if (u < 0.12) { const th = R() * Math.PI * 2; x = Math.cos(th) * Rm; y = Math.sin(th) * Rm; }
    else if (u < 0.2) { const th = ((R() * n) | 0) * sector - Math.PI / 2, r = R() * Rm; x = Math.cos(th) * r; y = Math.sin(th) * r; }
    else { const k = i % n, th = k * sector - Math.PI / 2 + (0.08 + R() * 0.84) * sector, r = Math.sqrt(R()) * Rm * aromas[k].intensidad / 10;
      x = Math.cos(th) * r; y = Math.sin(th) * r; }
    const z = (R() - .5) * 0.06;
    a.set([x, y * Math.cos(giro) - z * Math.sin(giro), y * Math.sin(giro) + z * Math.cos(giro)], i * 3); }
  return a;
}

/* ---------- el motor: WebGL2 directo ---------- */
const FOV = 34, DIST = 9.5, ESCALA_FOTO = 1.45;
const VERT = `
  uniform mat4 uProj, uMV; uniform float uT, uTime, uSize, uVel, uFoto;
  attribute vec3 aFrom, aTo, aCol; attribute float aRnd; varying float vA, vGlow; varying vec3 vCol;
  void main(){
    float t = smoothstep(0.0, 1.0, clamp((uT - aRnd * 0.3) / 0.7, 0.0, 1.0));
    vec3 p = mix(aFrom, aTo, t);
    float mid = sin(3.14159 * t);
    vec3 n = vec3(sin(p.y * 2.3 + uTime * 0.9 + aRnd * 6.28), cos(p.x * 1.9 + uTime * 0.7 + aRnd * 3.1), sin(p.z * 2.1 + uTime * 0.8 + aRnd * 1.7));
    p += n * ((0.012 + mid * 0.62 + uVel * 0.08) * (1.0 - uFoto * 0.9));
    vec4 mv = uMV * vec4(p, 1.0);
    gl_Position = uProj * mv;
    gl_PointSize = uSize * (0.55 + aRnd * 0.9) * (1.0 + mid * 0.7 + uFoto * 0.5) / -mv.z;
    vA = 0.45 + 0.55 * aRnd; vGlow = clamp(mid + uVel * 0.4, 0.0, 1.0); vCol = aCol;
  }`;
const FRAG = `
  precision highp float;
  uniform float uAlpha, uFoto; varying float vA, vGlow; varying vec3 vCol;
  void main(){
    float d = length(gl_PointCoord - 0.5); if (d > 0.5) discard;
    float s = smoothstep(0.5, 0.05, d);
    vec3 vino = vec3(0.40, 0.06, 0.18), rosa = vec3(0.86, 0.46, 0.60);
    vec3 col = mix(mix(vino, rosa, vGlow * 0.85 + (1.0 - vA) * 0.25), vCol * 1.15, uFoto);
    gl_FragColor = vec4(col, s * mix(vA, 1.0, uFoto) * uAlpha);
  }`;

function crearMotor(canvas, n) {
  const gl = canvas.getContext('webgl2', { alpha: true, antialias: false, premultipliedAlpha: true, powerPreference: 'high-performance' });
  if (!gl) return null;
  const sh = (tipo, src) => { const s = gl.createShader(tipo); gl.shaderSource(s, src); gl.compileShader(s);
    if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) throw new Error(gl.getShaderInfoLog(s)); return s; };
  const prog = gl.createProgram();
  gl.attachShader(prog, sh(gl.VERTEX_SHADER, VERT)); gl.attachShader(prog, sh(gl.FRAGMENT_SHADER, FRAG)); gl.linkProgram(prog);
  if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) throw new Error(gl.getProgramInfoLog(prog));
  gl.useProgram(prog);
  const vao = gl.createVertexArray(); gl.bindVertexArray(vao);
  const buffers = {};
  const atributo = (nombre, datos, tam) => {
    const b = gl.createBuffer(), loc = gl.getAttribLocation(prog, nombre);
    gl.bindBuffer(gl.ARRAY_BUFFER, b); gl.bufferData(gl.ARRAY_BUFFER, datos, gl.DYNAMIC_DRAW);
    gl.enableVertexAttribArray(loc); gl.vertexAttribPointer(loc, tam, gl.FLOAT, false, 0, 0); buffers[nombre] = b;
  };
  const u = {}; ['uProj', 'uMV', 'uT', 'uTime', 'uSize', 'uVel', 'uFoto', 'uAlpha'].forEach((k) => { u[k] = gl.getUniformLocation(prog, k); });
  gl.disable(gl.DEPTH_TEST); gl.enable(gl.BLEND);
  gl.blendFuncSeparate(gl.SRC_ALPHA, gl.ONE_MINUS_SRC_ALPHA, gl.ONE, gl.ONE_MINUS_SRC_ALPHA);
  let dpr = 1;
  return {
    atributo,
    subir(nombre, datos) { gl.bindBuffer(gl.ARRAY_BUFFER, buffers[nombre]); gl.bufferSubData(gl.ARRAY_BUFFER, 0, datos); },
    tamano() {
      dpr = Math.min(devicePixelRatio, 2);
      canvas.width = Math.round(innerWidth * dpr); canvas.height = Math.round(innerHeight * dpr);
      gl.viewport(0, 0, canvas.width, canvas.height);
      const f = 1 / Math.tan((FOV * Math.PI / 180) / 2), a = innerWidth / innerHeight, near = 0.1, far = 100;
      gl.uniformMatrix4fv(u.uProj, false, new Float32Array([f / a, 0, 0, 0, 0, f, 0, 0, 0, 0, (far + near) / (near - far), -1, 0, 0, (2 * far * near) / (near - far), 0]));
      gl.uniform1f(u.uSize, 44 * dpr);
    },
    /** Grupo: posición x, rotación X e Y (orden XYZ, como Three.js) y escala; la cámara está en z = DIST. */
    dibujar({ x, y = 0, rx, ry, s, t, tiempo, vel, foto, alfa }) {
      const cx = Math.cos(rx), sx = Math.sin(rx), cy = Math.cos(ry), sy = Math.sin(ry);
      // M = T · Rx · Ry · S, y la vista desplaza -DIST en z (columna a columna).
      gl.uniformMatrix4fv(u.uMV, false, new Float32Array([
        cy * s, sx * sy * s, -cx * sy * s, 0,
        0, cx * s, sx * s, 0,
        sy * s, -sx * cy * s, cx * cy * s, 0,
        x, y, -DIST, 1]));
      gl.uniform1f(u.uT, t); gl.uniform1f(u.uTime, tiempo); gl.uniform1f(u.uVel, vel); gl.uniform1f(u.uFoto, foto); gl.uniform1f(u.uAlpha, alfa);
      gl.clearColor(0, 0, 0, 0); gl.clear(gl.COLOR_BUFFER_BIT);
      gl.drawArrays(gl.POINTS, 0, n);
    },
  };
}

/* La forma 0 son las uvas de la foto: cada partícula nace en un píxel oscuro del racimo, con su color. */
function desdeFoto(img) {
  const colores = new Float32Array(N * 3), pos = new Float32Array(N * 3);
  const Wc = 320, Hc = Math.round(320 * innerHeight / innerWidth);
  const c = document.createElement('canvas'); c.width = Wc; c.height = Hc; const ctx = c.getContext('2d');
  const s = Math.max(Wc / img.naturalWidth, Hc / img.naturalHeight);
  ctx.drawImage(img, (Wc - img.naturalWidth * s) / 2, (Hc - img.naturalHeight * s) / 2, img.naturalWidth * s, img.naturalHeight * s);
  const d = ctx.getImageData(0, 0, Wc, Hc).data, cand = [];
  for (let y = 0; y < Hc; y++) for (let x = 0; x < Wc; x++) { const k = (y * Wc + x) * 4, l = (0.3 * d[k] + 0.59 * d[k + 1] + 0.11 * d[k + 2]) / 255; if (l < 0.3 && d[k + 2] >= d[k + 1]) cand.push(k / 4); }
  const hMundo = 2 * Math.tan((FOV / 2) * Math.PI / 180) * DIST, wMundo = hMundo * innerWidth / innerHeight;
  for (let i = 0; i < N; i++) {
    const id = cand.length > 800 ? cand[(R() * cand.length) | 0] : (R() * Wc * Hc) | 0, x = id % Wc, y = (id / Wc) | 0, k = id * 4;
    pos.set([((x + R()) / Wc - 0.5) * wMundo * ESCALA_FOTO, -((y + R()) / Hc - 0.5) * hMundo * ESCALA_FOTO, (R() - .5) * 0.05], i * 3);
    colores.set([d[k] / 255, d[k + 1] / 255, d[k + 2] / 255], i * 3);
  }
  return { pos, colores };
}

const formas = [racimo(), racimo(), probetasDe(B.anadas), globoDe(B.mercados), redDe(B.canales), ruedaDe(B.vino.aromas), botella(), web()];
const NF = formas.length - 1;
const motor = crearMotor(document.getElementById('gl'), N);
const rnd = new Float32Array(N); for (let i = 0; i < N; i++) rnd[i] = R();
let segmento = -1;
if (motor) {
  document.body.classList.add('con-etiquetas');
  motor.atributo('aFrom', formas[0].slice(), 3);
  motor.atributo('aTo', formas[1].slice(), 3);
  motor.atributo('aCol', new Float32Array(N * 3).fill(0.4), 3);
  motor.atributo('aRnd', rnd, 1);
  motor.tamano();
  addEventListener('resize', () => motor.tamano());
}
const imgUvas = new Image(); imgUvas.crossOrigin = 'anonymous';
imgUvas.onload = () => { try { const r = desdeFoto(imgUvas); formas[0] = r.pos; motor?.subir('aCol', r.colores); segmento = -1; } catch (e) { console.warn('Sin muestreo de la foto:', e); } };
imgUvas.src = 'https://images.unsplash.com/photo-1537640538966-79f369143f8f?w=1200&q=70';
document.getElementById('motorKB').textContent = (crearMotor.toString().length / 1024 + (VERT.length + FRAG.length) / 1024).toFixed(1) + ' KB';


/* ---------- cifras sobre la forma: etiquetas HTML proyectadas con la misma cámara que las partículas ---------- */
const miles = (n) => n.toLocaleString('es-ES');
const giroX = (p, g) => [p[0], p[1] * Math.cos(g) - p[2] * Math.sin(g), p[1] * Math.sin(g) + p[2] * Math.cos(g)];
const giroWeb = (x, y) => { const ry = -0.45, rx = 0.12, x1 = x * Math.cos(ry), z1 = -x * Math.sin(ry); return [x1, y * Math.cos(rx) - z1 * Math.sin(rx), y * Math.sin(rx) + z1 * Math.cos(rx)]; };
const ETIQ = (() => {
  const rad = Math.PI / 180, nA = B.anadas.length, totC = B.canales.reduce((s, c) => s + c.pct, 0), nR = B.vino.aromas.length, sec = Math.PI * 2 / nR;
  return [
    B.anadas.map((a, k) => ({ p: [(k - (nA - 1) / 2) * 1.1, -1.95, 0], b: `${Math.round(a.botellas / 1000)} mil`, s: `${a.anio}` })),
    B.mercados.map((m) => { const la = m.lat * rad, lo = (m.lon - B.mercados[0].lon) * rad, r = 1.7 * 1.22;
      return { p: [Math.cos(la) * Math.sin(lo) * r, Math.sin(la) * r, Math.cos(la) * Math.cos(lo) * r], b: `${m.pct} %`, s: m.pais, cara: true }; }),
    [{ p: [0, -0.62, 0], b: 'Cliente', s: 'en el centro' }, ...B.canales.map((c, k) => { const t = k / B.canales.length * Math.PI * 2 - Math.PI / 2, rr = 0.12 + 0.55 * Math.sqrt(c.pct / totC);
      const h = [Math.cos(t) * 2, Math.sin(t) * 1.35], l = Math.hypot(h[0], h[1]), d = rr + 0.45;
      return { p: [h[0] + h[0] / l * d, h[1] + h[1] / l * d, Math.sin(t * 2) * 0.5], b: `${c.pct} %`, s: c.canal }; })],
    B.vino.aromas.map((a, k) => { const th = k * sec - Math.PI / 2 + sec / 2, r = 1.9 * 1.24;
      return { p: giroX([Math.cos(th) * r, Math.sin(th) * r, 0], 0.35), b: String(a.intensidad), s: a.aroma }; }),
    [{ p: [0.95, 0.95, 0], b: B.vino.precio, s: 'precio', izq: true }, { p: [0.95, 0.15, 0], b: miles(B.vino.stock), s: 'botellas en stock', izq: true },
     { p: [0.95, -0.65, 0], b: B.vino.formato, s: B.vino.nombre, izq: true }],
    [{ p: giroWeb(-1.2, -0.5), b: 'Historia', s: 'Markdown', chip: true }, { p: giroWeb(-0.05, -0.5), b: 'Datos', s: 'JSON', chip: true }, { p: giroWeb(1.15, -0.5), b: 'Tienda', s: 'API', chip: true }],
  ];
})();
const capaEtiq = document.getElementById('etiquetas');
const elsEtiq = ETIQ.map((grupo, k) => grupo.map((e) => {
  const el = document.createElement('div'); el.className = 'et' + (e.izq ? ' izq' : '') + (e.chip ? ' chip' : '');
  el.innerHTML = `<b></b><span></span>`; el.querySelector('b').textContent = e.b; el.querySelector('span').textContent = e.s;
  capaEtiq.appendChild(el); return { e, el, ancho: 0 };
}));
const medirEtiquetas = () => elsEtiq.flat().forEach((o) => { o.ancho = o.el.offsetWidth; o.alto = o.el.offsetHeight; });
addEventListener('resize', medirEtiquetas); document.fonts?.ready.then(medirEtiquetas); setTimeout(medirEtiquetas, 800);
/** Proyecta un punto de la forma a la pantalla con la misma matriz que dibujar(): T · Rx · Ry · S y perspectiva. */
function proyectar(p, { x, y, rx, ry, s }) {
  const cx = Math.cos(rx), sx = Math.sin(rx), cy = Math.cos(ry), sy = Math.sin(ry);
  const X = cy * s * p[0] + sy * s * p[2] + x;
  const Y = sx * sy * s * p[0] + cx * s * p[1] - sx * cy * s * p[2] + y;
  const Zc = -cx * sy * s * p[0] + sx * s * p[1] + cx * cy * s * p[2];
  const f = 1 / Math.tan((FOV * Math.PI / 180) / 2), a = innerWidth / innerHeight, w = DIST - Zc;
  return { sx: ((f / a) * X / w + 1) / 2 * innerWidth, sy: (1 - f * Y / w) / 2 * innerHeight, frente: Zc };
}
function pintarEtiquetas(m, vista, apagar) {
  const k = Math.round(m) - 2, cerca = 1 - clamp(Math.abs(m - Math.round(m)) / 0.3), margen = 10, visibles = [];
  elsEtiq.forEach((grupo, g) => grupo.forEach((o) => {
    let op = g === k ? cerca * (1 - apagar) : 0;
    if (op > 0.01) {
      const q = proyectar(o.e.p, vista);
      if (o.e.cara) op *= clamp((q.frente + 0.2) / 0.6);
      const izq = o.e.izq ? Math.min(q.sx, innerWidth - margen - o.ancho) : clamp(q.sx - o.ancho / 2, margen, innerWidth - margen - o.ancho);
      if (op > 0.01) { visibles.push({ o, op, x: izq, y: q.sy - (o.alto || 40) / 2 }); return; }
    }
    if (o.el.style.opacity !== '0') o.el.style.opacity = '0';
  }));
  // En el globo los países europeos caen juntos: sus etiquetas van en dos columnas, a los lados del globo.
  if (visibles.length && visibles[0].o.e.cara) {
    const c = proyectar([0, 0, 0], vista), r = Math.abs(proyectar([0, 1.7, 0], vista).sy - c.sy);
    visibles.forEach((v) => { const q = proyectar(v.o.e.p, vista), der = q.sx >= c.sx;
      v.x = der ? Math.min(c.sx + r + 12, innerWidth - margen - v.o.ancho) : Math.max(c.sx - r - 12 - v.o.ancho, margen); v.der = der; });
  }
  // Las que se pisan bajan hasta dejar hueco (de arriba abajo).
  visibles.sort((a, b) => a.y - b.y).forEach((a, i) => {
    for (let j = 0; j < i; j++) { const b = visibles[j], h = b.o.alto || 40;
      if (a.x < b.x + b.o.ancho + 6 && b.x < a.x + a.o.ancho + 6 && a.y < b.y + h + 2 && b.y < a.y + h + 2) a.y = b.y + h + 2; }
    a.o.el.style.opacity = a.op.toFixed(3);
    a.o.el.style.transform = `translate(${a.x.toFixed(1)}px, ${a.y.toFixed(1)}px)`;
  });
}

/* ---------- scroll (igual que la otra maqueta) ---------- */
// En pantallas táctiles, scroll nativo: el suavizado no aporta y desplaza los saltos a cada paso.
let lenis = null; if (!matchMedia('(pointer: coarse)').matches) { try { lenis = new Lenis({ lerp: 0.085, smoothWheel: true }); } catch (e) {} }
const vuelo = document.getElementById('vuelo'), f1 = document.getElementById('f1'), f2 = document.getElementById('f2'), sombra = document.getElementById('sombra');
const fotos = document.getElementById('fotos'), escarcha = document.getElementById('escarcha');
const b1 = document.getElementById('beat1'), b2 = document.getElementById('beat2'), medio = document.getElementById('medio');
const pasos = [...document.querySelectorAll('section.scene')];
const gal = document.getElementById('gal'), track = document.getElementById('track');
const railSpans = [...document.querySelectorAll('#rail span')];
const hudIdx = document.getElementById('hudIdx'), hudName = document.getElementById('hudName'), hudPct = document.getElementById('hudPct');
let raton = [0, 0]; addEventListener('pointermove', (e) => { raton = [e.clientX / innerWidth - 0.5, e.clientY / innerHeight - 0.5]; });
let m = 0, activo = 0, ultimo = scrollY, vel = 0, oscuro = true, uFoto = 1;

function objetivoM(y) {
  const finVuelo = vuelo.offsetTop + vuelo.offsetHeight - innerHeight;
  if (y <= finVuelo) return suave(tramo(y / finVuelo, 0.76, 0.98));
  const anc = [[finVuelo, 1], ...pasos.map((s, i) => [s.offsetTop + s.offsetHeight / 2 - innerHeight / 2, i + 2])];
  for (let i = 0; i < anc.length - 1; i++) if (y < anc[i + 1][0]) return anc[i][1] + (y - anc[i][0]) / (anc[i + 1][0] - anc[i][0]);
  return NF;
}
function vueloVisual(y) {
  const p = clamp(y / (vuelo.offsetTop + vuelo.offsetHeight - innerHeight));
  const a = suave(tramo(p, 0, 0.46));
  f1.style.transform = `scale(${1.02 + a * 1.9}) translateY(${a * -4}%)`;
  f1.style.transformOrigin = '50% 78%';
  f1.style.opacity = 1 - suave(tramo(p, 0.38, 0.5));
  const b = suave(tramo(p, 0.4, 0.68));
  f2.style.opacity = suave(tramo(p, 0.38, 0.5)) * (1 - suave(tramo(p, 0.74, 0.86)));
  f2.style.transform = `scale(${1.25 + b * (ESCALA_FOTO - 1.25)})`;
  const e1 = Math.sin(Math.PI * tramo(p, 0.36, 0.54)), e2 = tramo(p, 0.72, 0.9);
  escarcha.style.setProperty('--b', (e1 * 22 + e2 * 14) + 'px');
  escarcha.style.setProperty('--a', (e1 * 0.12 + suave(e2) * 1).toFixed(3));
  sombra.style.opacity = 1 - tramo(p, 0.6, 0.8);
  fotos.style.visibility = p >= 0.999 ? 'hidden' : 'visible';
  b1.style.opacity = 1 - suave(tramo(p, 0.08, 0.22)); b1.style.transform = `translateY(${-tramo(p, 0.05, 0.25) * 60}px)`;
  medio.style.opacity = Math.sin(Math.PI * tramo(p, 0.5, 0.74)) * 0.95;
  b2.style.opacity = suave(tramo(p, 0.9, 1)); b2.style.transform = `translateY(${(1 - tramo(p, 0.9, 1)) * 30}px)`;
  uFoto = 1 - suave(tramo(p, 0.8, 0.97));
  const osc = p < 0.84; if (osc !== oscuro) { oscuro = osc; document.body.classList.toggle('oscuro', osc); }
  return suave(tramo(p, 0.7, 0.8));
}
function cuadro(t) {
  lenis?.raf(t);
  const y = scrollY; vel += (Math.abs(y - ultimo) / 40 - vel) * 0.1; ultimo = y;
  const aparece = vueloVisual(y);
  m += (objetivoM(y) - m) * (m < 1.02 ? 0.2 : 0.07);
  const i = Math.min(NF - 1, Math.floor(m)), f = m - i;
  if (motor && i !== segmento) { segmento = i; motor.subir('aFrom', formas[i]); motor.subir('aTo', formas[i + 1]); }
  const ancho = innerWidth > 860, k = clamp(m);
  const galIni = gal.offsetTop - innerHeight, desv = clamp((y - galIni) / (innerHeight * 0.7));
  const vista = {
    x: !ancho ? 0 : m <= 1 ? k * 1.5 : 1.5 + clamp(m - 1) * 0.7,
    y: ancho ? 0 : -1.05 * clamp(m - 1),
    s: ancho ? 1 + 0.1 * k - 0.1 * clamp(m - 1) : 0.72 - 0.3 * clamp(m - 1),
    ry: (Math.sin(t / 4200) * 0.55 + raton[0] * 0.5) * k,
    rx: raton[1] * 0.22 * k,
  };
  motor?.dibujar({ ...vista, t: m >= NF ? 1 : f, tiempo: t / 1000, vel: Math.min(1, vel), foto: uFoto,
    alfa: aparece * (1 - desv * 0.9) });
  if (motor) pintarEtiquetas(m, vista, desv);
  const act = Math.max(0, Math.round(Math.min(m, NF)) - 1);
  if (act !== activo) { activo = act; railSpans.forEach((s, j) => s.classList.toggle('on', j === act)); hudIdx.textContent = `[0${act}/0${NF - 1}]`; descifrar(hudName, act === 0 ? 'APERTURA' : pasos[act - 1].dataset.name); }
  hudPct.textContent = String(Math.round(y / (document.documentElement.scrollHeight - innerHeight) * 100)).padStart(3, '0') + '%';
  const pg = clamp((y - gal.offsetTop) / (gal.offsetHeight - innerHeight));
  track.style.transform = `translate3d(${-pg * (track.scrollWidth - innerWidth + 40)}px,0,0)`;
  requestAnimationFrame(cuadro);
}

/* ---------- precarga ---------- */
const pre = document.getElementById('pre'), preTxt = document.getElementById('preTxt'), t0 = performance.now();
(function carga(t) {
  const p = Math.min(1, Math.max(0, (t - t0) / 1600)), n = Math.round(p * 12);
  preTxt.textContent = 'bodega ' + '▓'.repeat(n) + '░'.repeat(12 - n) + ' ' + String(Math.round(p * 100)).padStart(3, '0');
  if (p < 1 || !f1.complete) requestAnimationFrame(carga);
  else { pre.classList.add('out'); requestAnimationFrame(cuadro); }
})(t0);
</script>
