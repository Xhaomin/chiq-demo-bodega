    const oro = gg < 0.42 && letras.length; col.set(oro ? mezcla(ORO[0], ORO[1], U4[(i * 7) % N]) : mezcla(VINO_SELLO[0], VINO_SELLO[1], U4[(i * 7) % N]), i * 3);
