// Los datos de la bodega son ficticios; la forma de cada paso se calcula con ellos en el navegador.
import B from '../data/bodega.json';

// Con separador también en las cifras de cuatro dígitos (2.500), como el resto de la página.
const miles = (n: number) => n.toLocaleString('es-ES', { useGrouping: 'always' } as Intl.NumberFormatOptions);
const JSON_BODEGA = JSON.stringify(B).replace(/</g, '\\u003c');

// Del racimo a la botella: un paso por pantalla. Las toneladas y las botellas se calculan, no se escriben.
const E = B.elaboracion, ultimo = B.anios.length - 1;
const toneladas = E.hectareas * E.kg_por_ha / 1000;
const botellas = B.marcas.reduce((s, x) => s + x.miles_botellas[ultimo], 0) * 1000;
const ELAB = [
  { corto: 'Vendimia', cifra: `${miles(E.kg_por_ha)} kg/ha`, paso: `La vendimia · ${E.hectareas} ha a mano`,
    etiquetas: [{ b: `${E.hectareas} ha`, s: `vendimiadas ${E.vendimia}` }, { b: `${miles(E.kg_por_ha)} kg/ha`, s: 'de rendimiento' }, { b: `${miles(toneladas)} t`, s: 'de uva' }] },
  { corto: 'Depósito', cifra: `${miles(E.litros_deposito)} litros`, paso: `El depósito · ${E.dias_deposito} días`,
    etiquetas: [{ b: `${miles(E.litros_deposito)} litros`, s: 'de vino' }, { b: `${E.dias_deposito} días`, s: 'en depósito' }] },
  { corto: 'Crianza', cifra: `${miles(E.barricas)} barricas`, paso: `La crianza · ${E.meses_barrica} meses`,
    etiquetas: [{ b: miles(E.barricas), s: `barricas de roble ${E.roble}` }, { b: `${E.meses_barrica} meses`, s: 'de crianza' }] },
  { corto: 'Botella', cifra: miles(botellas), paso: `Botellas en ${B.anios[ultimo]}`,
    etiquetas: [{ b: miles(botellas), s: `botellas en ${B.anios[ultimo]}`, t: 'suma de las cuatro marcas' }] },
];
const JSON_ELAB = JSON.stringify(ELAB).replace(/</g, '\\u003c');

// El ensamblaje: las parcelas que entran en el vino que lo tiene en bodega.json, con su variedad y su año.
const RESERVA = B.vinos.find((v) => 'ensamblaje' in v) as (typeof B.vinos)[number] & { ensamblaje: { parcela: string; pct: number }[] };
const ENS = RESERVA.ensamblaje.map((e) => ({ ...e, ...B.terruno.parcelas.find((p) => p.nombre === e.parcela)! }));
const CUANTAS = ['Una', 'Dos', 'Tres', 'Cuatro', 'Cinco'][ENS.length - 1];
const lista = (xs: string[]) => new Intl.ListFormat('es', { type: 'conjunction' }).format(xs);
