/* El depósito de acero, visto un poco desde arriba, con el vino dentro hasta su nivel. */
const DEP = { r: 0.82, y0: -1.25, y1: 1.05, giro: 0.28 }; DEP.nivel = DEP.y0 + (DEP.y1 - DEP.y0) * 0.78;
function deposito() {
  const { r, y0, y1, nivel, giro } = DEP;
  return conColor((i) => { const g = U2[i], th = U1[i] * Math.PI * 2, c = Math.cos(th), s = Math.sin(th), u = U3[i], v = U4[i]; let q, col = ACERO;
    if (g < 0.26) q = [c * r, y0 + u * (y1 - y0), s * r];   // pared
    else if (g < 0.32) { q = [c * r * 1.02, (u < 0.5 ? 0.55 : -0.05) + (v - .5) * 0.16, s * r * 1.02]; col = ACERO_OSC; }   // camisas de frío
    else if (g < 0.4) { const rr = r * (1 - u * 0.8); q = [c * rr, y1 + u * 0.36, s * rr]; }   // techo cónico
    else if (g < 0.43) { const an = Math.floor(u * 4) * Math.PI / 2 + Math.PI / 4; q = [Math.cos(an) * r * 0.75, y0 - v * 0.38, Math.sin(an) * r * 0.75]; }   // patas
    else if (g < 0.45) { const an = Math.PI / 2 + c * 0.3; q = [Math.cos(an) * r * 1.01, -0.8 + s * 0.2, Math.sin(an) * r * 1.01]; col = ACERO_OSC; }   // puerta
    else if (g < 0.53) { const rr = Math.sqrt(u) * r * 0.96; q = [c * rr, nivel, s * rr]; col = VINO[1]; }   // superficie del vino
    else { const rr = Math.sqrt(u) * r * 0.93; q = [c * rr, y0 + v * (nivel - y0), s * rr]; col = mezcla(VINO[0], VINO[1], U1[(i * 7) % N] * 0.5); }
