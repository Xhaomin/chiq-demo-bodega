}
/* Del racimo a la botella: cuatro formas con color propio por partícula (uva, acero, roble y vidrio). Las cifras salen
   de bodega.json; aquí solo se dibuja. Entre pasos no hay dispersión: cada partícula viaja recta a su sitio nuevo. */
const ELAB = JSON.parse(document.getElementById('pasos-elaboracion').textContent);
