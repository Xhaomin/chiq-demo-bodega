    else if (g < 0.37) q = [LOSA[0] + u * (LOSA[1] - LOSA[0]), LOSA[2] + v * (LOSA[3] - LOSA[2]), LOSA[4]];
    else if (g < 0.385) { q = [22 + Math.floor(w * 4) * 40, 38 + u * 10, 4]; c = ACERO_OSC; }   // pilares bajo la losa
    else if (g < 0.55) { q = [36 + u * 114, 12 + Math.floor(w * 7) * 1.8 + u * 35, -0.5]; c = mezcla(VINO[0], VINO[1], v * 0.5); }   // la banda de lamas, en diagonal
    else if (g < 0.575) { q = aristaCaja(MIRADOR, Math.floor(w * 12), u); c = ACERO_OSC; }   // el mirador de cristal
    else if (g < 0.61) { q = [MIRADOR[0] + u * 16, MIRADOR[2] + v * 14, MIRADOR[4]]; c = ROSA; }
    else if (g < 0.63) q = [PORTON[0] + u * 24, v * 26, -0.3];   // el portón
    else if (g < 0.69) { q = [PORTON[0] + u * 24, 2 + Math.floor(v * 9) * 3, -0.6]; c = ARO; }   // y sus lamas
    else if (g < 0.8) { const [cx, h] = CIPRESES[Math.floor(w * 3)], r = 4.2 * Math.sin(Math.PI * Math.min(1, u * 1.15)), th = v * Math.PI * 2, rr = Math.sqrt(U1[(i * 13) % N]) * r;
