const formas = [racimo(), racimo()], escenaDe = [-1, -1], inicio = [], COLORES = [null, null];
PLAN.forEach((e, s) => { inicio.push(formas.length); for (let j = 0; j < e.n; j++) { formas.push(e.forma(j)); escenaDe.push(s); COLORES.push(e.color ? e.color(j) : null); } });
const NF = formas.length - 1;
let coloresFoto = new Float32Array(N * 3).fill(0.4), segmento = -1;
document.fonts.load('italic 500 80px "Newsreader"').then(() => { const s = sello(); formas[inicio[4]] = s.pos; COLORES[inicio[4]] = s.col; segmento = -1; }, () => {});
const vistaDe = (f, movil) => (escenaDe[f] < 0 ? VISTA_APERTURA[f] : PLAN[escenaDe[f]].vista)[movil ? 'm' : 'd'];
const motor = crearMotor(document.getElementById('gl'), N);
const rnd = new Float32Array(N); for (let i = 0; i < N; i++) rnd[i] = R();
if (motor) {
  document.body.classList.add('con-etiquetas');
  motor.atributo('aFrom', formas[0].slice(), 3);
  motor.atributo('aTo', formas[1].slice(), 3);
  motor.atributo('aCol', new Float32Array(N * 3).fill(0.4), 3);
  motor.atributo('aCol2', new Float32Array(N * 3).fill(0.4), 3);
