}
const imgUvas = new Image(); imgUvas.crossOrigin = 'anonymous';
imgUvas.onload = () => { try { const r = desdeFoto(imgUvas); formas[0] = r.pos; coloresFoto = r.colores; segmento = -1; } catch (e) { console.warn('Sin muestreo de la foto:', e); } };
imgUvas.src = 'https://images.unsplash.com/photo-1537640538966-79f369143f8f?w=1200&q=70';
document.getElementById('motorKB').textContent = (crearMotor.toString().length / 1024 + (VERT.length + FRAG.length) / 1024).toFixed(1) + ' KB';

/* ---------- cifras sobre la forma: etiquetas HTML proyectadas con la misma cámara que las moléculas ---------- */
const ETIQ = [];
ETIQ[inicio[0] + 1] = PARCELAS.map((p) => ({ p: enLadera(p.x, p.z, 0.5), b: p.nombre, s: `${p.variedad} · ${p.plantada}` }));
B.vinos.forEach((v, w) => { ETIQ[inicio[1] + w] = B.aromas.map((a, k) => ({ a, k })).filter(({ k }) => v.cata[k] > 0).map(({ a, k }) => {
  const th = k * SEC - Math.PI / 2 + SEC / 2, r = RM * 1.24; return { p: giroX([Math.cos(th) * r, Math.sin(th) * r, 0], GIRO_RUEDA), b: String(v.cata[k]), s: a }; }); });
// La visita: las visitas sobre el mirador; los días y el club, bajo el edificio (en el móvil, `pm`, en columna).
const dias = B.visitas.dias[0].toUpperCase() + B.visitas.dias.slice(1);
ETIQ[inicio[2]] = [{ p: aMundo([68, 82, 21]), b: miles(B.visitas.al_anio), s: 'visitas al año' }, { p: aMundo([40, -16, 0]), pm: aMundo([85, -16, 0]), b: dias, s: B.visitas.cata },
  { p: aMundo([130, -16, 0]), pm: aMundo([85, -16, 0]), b: `1 de cada ${B.visitas.socio_uno_de_cada}`, s: 'se hace socio del club' }];
ETIQ[inicio[3]] = [{ p: [0.95, 0.95, 0], b: B.vinos[0].precio, s: 'precio', izq: true }, { p: [0.95, 0.15, 0], b: miles(B.vinos[0].stock), s: 'botellas en stock', izq: true },
  { p: [0.95, -0.65, 0], b: B.vinos[0].formato, s: B.vinos[0].nombre, izq: true }];
const capaEtiq = document.getElementById('etiquetas');
const elsEtiq = ETIQ.map((grupo) => (grupo || []).map((e) => {
  const el = document.createElement('div'); el.className = 'et' + (e.izq ? ' izq' : '');
  el.innerHTML = '<b></b><span></span>'; el.querySelector('b').textContent = e.b; el.querySelector('span').textContent = e.s;
  capaEtiq.appendChild(el); return { e, el, ancho: 0, alto: 0 };
}));
const medirEtiquetas = () => elsEtiq.flat().forEach((o) => { o.ancho = o.el.offsetWidth; o.alto = o.el.offsetHeight; });
addEventListener('resize', medirEtiquetas); document.fonts?.ready.then(medirEtiquetas); setTimeout(medirEtiquetas, 800);
/** Proyecta un punto de la forma a la pantalla con la misma matriz que dibujar(): T · Rx · Ry · S y perspectiva. */
function proyectar(p, { x, y, rx, ry, s }) {
  const cx = Math.cos(rx), sx = Math.sin(rx), cy = Math.cos(ry), sy = Math.sin(ry);
  const X = cy * s * p[0] + sy * s * p[2] + x;
  const Y = sx * sy * s * p[0] + cx * s * p[1] - sx * cy * s * p[2] + y;
  const Zc = -cx * sy * s * p[0] + sx * s * p[1] + cx * cy * s * p[2];
