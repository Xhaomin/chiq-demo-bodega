const GRIS = [0.66, 0.64, 0.62], ACERO = [0.6, 0.59, 0.58], ACERO_OSC = [0.42, 0.41, 0.4], VINO = [rgb('#6e1432'), rgb('#a3456a')], ROSA = rgb('#d493ad'), ARO = rgb('#3a2a24'), UVA = rgb('#33081a');
