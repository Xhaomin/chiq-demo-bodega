  const aparece = vueloVisual(y);
  m += (objetivoM(y) - m) * (m < 1.02 ? 0.2 : 0.07);
  const i = Math.min(NF - 1, Math.floor(m)), f = m - i;
  if (motor && i !== segmento) { segmento = i; motor.subir('aFrom', formas[i]); motor.subir('aTo', formas[i + 1]);
    motor.subir('aCol', COLORES[i] || COLORES[i + 1] || coloresFoto); motor.subir('aCol2', COLORES[i + 1] || COLORES[i] || coloresFoto); }
  // Entre dos pasos de la misma escena, sin dispersión: la ladera se queda y solo se juntan las parcelas.
  const calma = escenaDe[i] >= 0 && escenaDe[i] === escenaDe[i + 1] ? 1 : 0;
  const fr = Math.round(Math.min(m, NF)), esc = escenaDe[fr], quieta = esc >= 0 && PLAN[esc].n > 1;
  // La vista pasa de la de una forma a la de la siguiente; la foto se queda en su sitio hasta que empieza el racimo.
  const movil = innerWidth <= 860, va = vistaDe(i, movil), vb = vistaDe(i + 1, movil), kv = i === 0 ? suave(tramo(f, 0.55, 1)) : suave(clamp(f));
