}
function probetas() {
  const a = new Float32Array(N * 3), xs = [-1.15, 0, 1.15], lv = [.82, .62, .38];
  for (let i = 0; i < N; i++) { const k = i % 3, x = xs[k], r = 0.36, th = R() * Math.PI * 2;
    if (R() < 0.5) a.set([x + Math.cos(th) * r, -1.5 + R() * 3, Math.sin(th) * r], i * 3);
    else { const rr = Math.sqrt(R()) * r * 0.9; a.set([x + Math.cos(th) * rr, -1.5 + R() * 3 * lv[k], Math.sin(th) * rr], i * 3); } }
  return a;
}
function globo() {
  const a = new Float32Array(N * 3), r0 = 1.7;
  for (let i = 0; i < N; i++) { let p;
    if (R() < 0.45) { const an = (R() * 9) | 0, t = R() * Math.PI * 2;
      if (R() < 0.5) { const lat = (an / 8 - 0.5) * Math.PI; p = [Math.cos(lat) * Math.cos(t) * r0, Math.sin(lat) * r0, Math.cos(lat) * Math.sin(t) * r0]; }
      else { const lon = an / 9 * Math.PI; p = [Math.cos(t) * Math.cos(lon) * r0, Math.sin(t) * r0, Math.cos(t) * Math.sin(lon) * r0]; } }
    else p = esfera([0, 0, 0], r0 * (0.97 + R() * 0.06));
    a.set(p, i * 3); }
  return a;
}
/** Radio de la botella a cada altura: cuerpo, hombro, cuello y boca. */
const perfilBotella = (y) => y < 0.3 ? 0.64 : y < 0.95 ? 0.21 + 0.43 * (0.5 + 0.5 * Math.cos((y - 0.3) / 0.65 * Math.PI)) : (y > 1.6 ? 0.25 : 0.21);
function botella() {
  const a = new Float32Array(N * 3), perfil = perfilBotella;
  for (let i = 0; i < N; i++) { const th = R() * Math.PI * 2;
    if (R() < 0.06) { const rr = Math.sqrt(R()) * 0.64; a.set([Math.cos(th) * rr, -1.6, Math.sin(th) * rr], i * 3); continue; }
    const y = -1.6 + R() * 3.35, r = perfil(y); a.set([Math.cos(th) * r, y, Math.sin(th) * r], i * 3); }
  return a;
}


/* ---------- formas calculadas con los datos de la bodega (ficticios) ---------- */
const B = JSON.parse(document.getElementById('datos-bodega').textContent);
/* Azar fijo por partícula: entre dos años (o dos vinos) cada partícula conserva su sitio y solo cambia de altura o de radio. */
const U1 = new Float32Array(N), U2 = new Float32Array(N), U3 = new Float32Array(N), U4 = new Float32Array(N);
for (let i = 0; i < N; i++) { U1[i] = R(); U2[i] = R(); U3[i] = R(); U4[i] = R(); }
const MAX_BOT = Math.max(...B.marcas.flatMap((x) => x.miles_botellas));
const xsMarca = B.marcas.map((_, k) => (k - (B.marcas.length - 1) / 2) * 1.1);
/* Probetas como las del capítulo E2: cristal gris con su aro, líquido del color de cada marca con su superficie y un
   anillo oscuro en el nivel del primer año. Cada partícula tiene un papel fijo, así que entre años solo se mueve el nivel. */
const rgb = (h) => [1, 3, 5].map((o) => parseInt(h.slice(o, o + 2), 16) / 255);
const RAMPA = ['#33081a', '#7a1a3e', '#b35a80', '#d493ad'].map(rgb);
const GRIS = [0.66, 0.64, 0.62], OSCURO = [0.09, 0.07, 0.08];
const papel = (i) => { const g = U2[i]; return g < 0.2 ? 'vidrio' : g < 0.25 ? 'borde' : g < 0.31 ? 'marca' : g < 0.37 ? 'superficie' : 'liquido'; };
const nivelBot = (v) => -1.5 + 3 * 0.9 * v / MAX_BOT;
function probetasAnio(j) {
  const a = new Float32Array(N * 3), n = B.marcas.length, r = 0.34;
  for (let i = 0; i < N; i++) { const k = i % n, x = xsMarca[k], th = U1[i] * Math.PI * 2, c = Math.cos(th), s = Math.sin(th), bot = B.marcas[k].miles_botellas;
    switch (papel(i)) {
      case 'vidrio': a.set([x + c * r, -1.5 + U3[i] * 3, s * r], i * 3); break;
      case 'borde': a.set([x + c * r, 1.5 + (U3[i] - .5) * 0.02, s * r], i * 3); break;
      case 'marca': a.set([x + c * r * 1.06, nivelBot(bot[0]) + (U3[i] - .5) * 0.02, s * r * 1.06], i * 3); break;
      case 'superficie': a.set([x + c * r * 0.96, nivelBot(bot[j]) + (U3[i] - .5) * 0.02, s * r * 0.96], i * 3); break;
      default: { const rr = Math.sqrt(U3[i]) * r * 0.92; a.set([x + c * rr, -1.5 + U4[i] * (nivelBot(bot[j]) + 1.5), s * rr], i * 3); } } }
  return a;
}
const COLOR_PROBETAS = (() => { const c = new Float32Array(N * 3), n = B.marcas.length;
  for (let i = 0; i < N; i++) { const p = papel(i); c.set(p === 'vidrio' || p === 'borde' ? GRIS : p === 'marca' ? OSCURO : RAMPA[(i % n) % RAMPA.length], i * 3); }
  return c; })();
/** Gira un punto sobre el eje Y y después sobre el X (el mismo orden que la cámara). */
const girar = (q, ry, rx) => { const x1 = q[0] * Math.cos(ry) + q[2] * Math.sin(ry), z1 = -q[0] * Math.sin(ry) + q[2] * Math.cos(ry);
  return [x1, q[1] * Math.cos(rx) - z1 * Math.sin(rx), q[1] * Math.sin(rx) + z1 * Math.cos(rx)]; };
const giroX = (p, g) => girar(p, 0, g);
/* La ladera: cuatro bancales con su muro de piedra y dos hileras de cepas cada uno, vistos desde abajo y de lado. */
const BANCALES = B.terruno.parcelas.map((p, k) => ({ y: -1.3 + k * 0.62, z: 0.8 - k * 0.52, w: 1.75 - k * 0.16, p }));
const giroLadera = (q) => girar(q, -0.32, 0.3);
const CEPAS = BANCALES.flatMap((b) => [-0.11, 0.11].flatMap((dz) => { const n = Math.floor(2 * b.w / 0.32), out = [];
  for (let c = 0; c < n; c++) out.push({ x: -b.w + 0.16 + c * 0.32 + (dz > 0 ? 0.08 : 0), y: b.y, z: b.z + dz, s: c * 1.7 + b.y * 3 }); return out; }));
function ladera() {
  const a = new Float32Array(N * 3), nb = BANCALES.length;
  for (let i = 0; i < N; i++) { const g = U1[i], u = U2[i], v = U3[i]; let q;
    if (g < 0.2) { const b = BANCALES[i % nb], alto = b.y === BANCALES[0].y ? 0.3 : 0.6;   // muro de piedra: hiladas irregulares
      const fila = Math.floor(v * 6), yy = b.y - alto + (fila + 0.5) / 6 * alto + (U4[i] - .5) * 0.04;
      q = [-b.w + u * 2 * b.w, yy, b.z + 0.24 + Math.sin(u * 40 + fila) * 0.015]; }
    else if (g < 0.3) { const b = BANCALES[i % nb]; q = [-b.w + u * 2 * b.w, b.y, b.z - 0.24 + v * 0.48]; }   // suelo
    else { const c = CEPAS[i % CEPAS.length], parte = U4[i];
      if (parte < 0.32) { const h = u * 0.2; q = [c.x + Math.sin(h * 18 + c.s) * 0.018, c.y + h, c.z + Math.cos(h * 14 + c.s) * 0.012]; }   // tronco retorcido
      else if (parte < 0.55) { const brazo = Math.floor(v * 3), an = c.s + brazo * 2.1, h = u;   // brazos (cepa en vaso)
        q = [c.x + Math.cos(an) * 0.1 * h, c.y + 0.2 + 0.12 * h, c.z + Math.sin(an) * 0.08 * h]; }
      else { const lob = Math.floor(v * 3), an = c.s + lob * 2.1, cx = c.x + Math.cos(an) * 0.09, cz = c.z + Math.sin(an) * 0.07;   // hojas
        const th = u * Math.PI * 2, ph = Math.acos(2 * U3[(i * 7) % N] - 1), rr = 0.085 * Math.cbrt(U1[(i * 13) % N]);
