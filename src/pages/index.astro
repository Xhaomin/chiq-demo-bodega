---
// Los datos de la bodega son ficticios; la forma de cada paso se calcula con ellos en el navegador.
import B from '../data/bodega.json';

const miles = (n: number) => n.toLocaleString('es-ES');
const JSON_BODEGA = JSON.stringify(B).replace(/</g, '\\u003c');
---
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Bodega Ejemplo · demo de chiq.es</title>
<meta name="robots" content="noindex, nofollow">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter+Tight:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style is:global>
:root{--bg:#ebe8e3;--ink:#141011;--wine:#6e1432;--mute:#857d78;--line:rgba(20,16,17,.14);--hud:#857d78}
*{box-sizing:border-box;margin:0;padding:0}
html{background:var(--bg)}
body{color:var(--ink);font-family:'Inter Tight',system-ui,sans-serif;-webkit-font-smoothing:antialiased;overflow-x:hidden}
body.oscuro{--ink:#f4efe8;--line:rgba(244,239,232,.3);--hud:rgba(244,239,232,.72)}
header a,header .burger,.hud,.rail span{transition:color .6s,border-color .6s,background .6s}
.mono{font-family:'JetBrains Mono',ui-monospace,monospace;font-size:11px;letter-spacing:.12em;text-transform:uppercase}
#fotos{position:fixed;inset:0;z-index:1;overflow:hidden;background:#1a1210}
#fotos img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;will-change:transform,opacity,filter}
#fotos .sombra{position:absolute;inset:0;background:radial-gradient(ellipse 70% 45% at 50% 50%,rgba(10,6,6,.32),transparent 75%),linear-gradient(180deg,rgba(10,6,6,.5),rgba(10,6,6,.18) 45%,rgba(10,6,6,.55))}
#escarcha{position:fixed;inset:0;z-index:2;pointer-events:none;-webkit-backdrop-filter:blur(var(--b,0px)) saturate(1.2);backdrop-filter:blur(var(--b,0px)) saturate(1.2);background:rgba(235,232,227,var(--a,0))}
canvas#gl{position:fixed;inset:0;width:100vw;height:100vh;z-index:3;pointer-events:none}
.grain{position:fixed;inset:-50%;width:200%;height:200%;z-index:5;pointer-events:none;opacity:.08;
  background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='180' height='180'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='3' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
  animation:grain .9s steps(6) infinite}
@keyframes grain{0%{transform:translate(0,0)}20%{transform:translate(-3%,2%)}40%{transform:translate(2%,-3%)}60%{transform:translate(-2%,-1%)}80%{transform:translate(3%,3%)}100%{transform:translate(0,0)}}
header{position:fixed;top:0;left:0;right:0;z-index:20;display:flex;align-items:center;justify-content:space-between;padding:22px clamp(18px,3vw,40px)}
.logo{font-family:'Instrument Serif',serif;font-size:32px;letter-spacing:-.02em;color:var(--ink);text-decoration:none;line-height:1}
nav{display:flex;gap:26px;align-items:center}
nav a{color:var(--ink);text-decoration:none;font-size:14px;position:relative}
nav a:not(.btn)::after{content:'';position:absolute;left:0;right:100%;bottom:-3px;height:1px;background:currentColor;transition:right .45s cubic-bezier(.7,0,.2,1)}
nav a:not(.btn):hover::after{right:0}
.btn{border:1px solid var(--ink);border-radius:999px;padding:9px 18px;font-size:13px}
.btn:hover{background:var(--ink);color:#141011}
.burger{width:42px;height:42px;border-radius:50%;border:1px solid var(--line);display:grid;place-items:center;cursor:pointer;background:transparent}
.burger i{display:block;width:14px;height:1px;background:var(--ink);box-shadow:0 5px 0 var(--ink);transform:translateY(-2px)}
.hud{position:fixed;z-index:15;color:var(--hud);pointer-events:none;line-height:1.7}
.hud.tl{top:90px;left:clamp(18px,3vw,40px)}.hud.tr{top:90px;right:clamp(18px,3vw,40px);text-align:right}
.hud.bl{bottom:26px;left:clamp(18px,3vw,40px)}.hud.br{bottom:26px;right:clamp(18px,3vw,40px);text-align:right}
.hud .ink{color:var(--ink)}
.rail{position:fixed;z-index:15;right:clamp(18px,3vw,40px);top:50%;transform:translateY(-50%);display:flex;flex-direction:column;align-items:flex-end;gap:12px}
.rail span{width:16px;height:1px;background:var(--line)}
.rail span.on{width:40px;background:#a3456a}
.nota{position:fixed;z-index:30;left:50%;transform:translateX(-50%);bottom:26px;color:var(--hud);pointer-events:none}
main{position:relative;z-index:10}
/* vuelo */
#vuelo{height:520vh;position:relative}
.pin{position:sticky;top:0;height:100vh;overflow:hidden}
.beat{position:absolute;inset:0;display:flex;flex-direction:column;justify-content:center;padding:0 clamp(18px,7vw,120px);will-change:opacity,transform}
.beat1{align-items:center;text-align:center;color:#f4efe8}
.beat1 h1{font-family:'Instrument Serif',serif;font-weight:400;font-size:clamp(48px,8.6vw,138px);line-height:.93;letter-spacing:-.035em;max-width:13ch;text-shadow:0 2px 40px rgba(0,0,0,.25)}
.beat1 h1 em{font-style:italic;color:#f0b9cb}
.beat1 .cue{position:absolute;bottom:60px;left:50%;transform:translateX(-50%);color:rgba(244,239,232,.8)}
.beat1 .cue::after{content:'';display:block;width:1px;height:48px;background:#f4efe8;margin:12px auto 0;animation:cue 2.2s cubic-bezier(.7,0,.2,1) infinite}
@keyframes cue{0%{transform:scaleY(0);transform-origin:top}45%{transform:scaleY(1);transform-origin:top}55%{transform:scaleY(1);transform-origin:bottom}100%{transform:scaleY(0);transform-origin:bottom}}
.beat2{align-items:flex-start;max-width:none}
.beat2 .caja{max-width:470px}
.beat2 p.l{font-family:'Instrument Serif',serif;font-size:clamp(30px,3.4vw,52px);line-height:1.02;letter-spacing:-.02em}
.beat2 p.l em{font-style:italic;color:var(--wine)}
.beat2 .mono{color:var(--mute);margin-top:22px;display:block}
.medio{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);color:#f4efe8;text-align:center;opacity:0}
.medio .mono{color:rgba(244,239,232,.85);font-size:12px}
/* pasos */
section.scene{min-height:100vh;display:flex;align-items:center;padding:0 clamp(18px,7vw,120px);position:relative}
.step{max-width:600px}
.step .n{display:flex;gap:14px;align-items:center;color:var(--mute)}
.step .n b{color:var(--wine);font-weight:500}
.step .n::after{content:'';width:64px;height:1px;background:rgba(20,16,17,.14)}
.step h2{font-family:'Instrument Serif',serif;font-weight:400;font-size:clamp(42px,6.2vw,98px);line-height:.96;letter-spacing:-.03em;margin:24px 0;color:#141011}
.step h2 em{font-style:italic;color:var(--wine)}
.step p{font-size:clamp(16px,1.3vw,19px);line-height:1.55;color:#3a3334;max-width:38ch}
.cta{display:inline-flex;align-items:center;gap:14px;margin-top:34px;font-size:15px;color:#141011;text-decoration:none}
.cta .ar{width:46px;height:46px;border-radius:50%;border:1px solid #141011;display:grid;place-items:center;font-size:16px;transition:all .5s cubic-bezier(.7,0,.2,1)}
.cta:hover .ar{background:var(--wine);border-color:var(--wine);color:#fff;transform:rotate(-45deg)}
.tag{display:inline-block;margin-top:34px;padding:7px 13px;border:1px dashed var(--mute);border-radius:999px;color:var(--mute)}
.w{display:inline-block;overflow:hidden;vertical-align:top;padding-bottom:.08em;margin-bottom:-.08em}
.w>*{display:inline-block;transform:translateY(110%) rotate(4deg);transform-origin:left bottom;transition:transform 1.1s cubic-bezier(.16,.84,.24,1)}
.in .w>*{transform:none}
.fade{opacity:0;transform:translateY(22px);transition:opacity 1.1s .45s,transform 1.1s .45s cubic-bezier(.16,.84,.24,1)}
.in .fade{opacity:1;transform:none}
/* galería */
.gal{height:320vh;position:relative}
.gal-in{position:sticky;top:0;height:100vh;overflow:hidden;display:flex;flex-direction:column;justify-content:center}
.gal-head{padding:0 clamp(18px,7vw,120px);display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:40px}
.gal-head h3{font-family:'Instrument Serif',serif;font-weight:400;font-size:clamp(36px,4.4vw,66px);letter-spacing:-.025em;line-height:1;color:#141011}
.track{display:flex;gap:26px;padding:0 clamp(18px,7vw,120px);will-change:transform}
.panel{flex:0 0 min(430px,80vw);height:min(54vh,470px);border-radius:20px;background:rgba(255,255,255,.42);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border:1px solid rgba(255,255,255,.75);box-shadow:0 40px 80px -40px rgba(20,16,17,.35);padding:28px;display:flex;flex-direction:column;justify-content:flex-end;position:relative;overflow:hidden;color:#141011;text-decoration:none;transition:transform .6s cubic-bezier(.16,.84,.24,1)}
.panel:hover{transform:translateY(-8px)}
.panel h4{font-family:'Instrument Serif',serif;font-weight:400;font-size:48px;letter-spacing:-.025em;line-height:1;margin-bottom:12px}
.panel p{font-size:15px;color:#3a3334;max-width:30ch;line-height:1.5}
.panel .idx{position:absolute;left:28px;top:28px;color:var(--mute)}
.panel .new{position:absolute;right:28px;top:28px;color:var(--wine)}
.panel .ph{position:absolute;left:0;right:0;top:0;height:52%;background-size:cover;background-position:center;opacity:.9;mask-image:linear-gradient(#000 40%,transparent)}
footer{position:relative;z-index:10;padding:140px clamp(18px,7vw,120px) 40px;display:grid;gap:56px;background:var(--bg);color:#141011}
footer .big{font-family:'Instrument Serif',serif;font-size:clamp(40px,6vw,96px);letter-spacing:-.03em;line-height:.95;max-width:14ch}
footer .big em{font-style:italic;color:var(--wine)}
footer .cols{display:flex;flex-wrap:wrap;gap:40px 80px;justify-content:space-between;border-top:1px solid rgba(20,16,17,.14);padding-top:28px;color:var(--mute)}
footer .cols a{color:#141011;text-decoration:none;display:block;font-size:14px;line-height:2}
#pre{position:fixed;inset:0;z-index:60;background:#141011;color:#f4efe8;display:grid;place-items:center;transition:opacity .9s .2s,visibility .9s .2s}
#pre.out{opacity:0;visibility:hidden}
#menu{position:fixed;inset:0;z-index:40;background:#141011;color:#f4efe8;clip-path:circle(0% at calc(100% - 62px) 43px);transition:clip-path 1s cubic-bezier(.7,0,.2,1);display:flex;flex-direction:column;justify-content:center;padding:0 clamp(18px,7vw,120px)}
#menu.open{clip-path:circle(160% at calc(100% - 62px) 43px)}
#menu a{font-family:'Instrument Serif',serif;font-size:clamp(42px,6.4vw,96px);color:#f4efe8;text-decoration:none;line-height:1.08;display:flex;gap:26px;align-items:baseline;transition:color .3s,padding .5s cubic-bezier(.16,.84,.24,1)}
#menu a:hover{color:#d88aa6;padding-left:18px}
#menu a small{font-family:'JetBrains Mono',monospace;font-size:12px;color:#8d8580}
#menu .seal{position:absolute;bottom:32px;left:clamp(18px,7vw,120px);color:#8d8580}
#menu .close{position:absolute;top:22px;right:clamp(18px,3vw,40px);color:#f4efe8;background:none;border:1px solid #4a4244;border-radius:999px;padding:10px 18px;cursor:pointer}
@media (max-width:860px){nav a{display:none}.hud.tr,.rail,.nota{display:none}.step h2{font-size:44px}}

footer .pie-t{display:block;font-size:14px;line-height:1.5;opacity:.75;max-width:30ch}
.datos{list-style:none;margin:20px 0 22px;display:grid;gap:7px;color:var(--mute);max-width:46ch}
.datos li{line-height:1.5}
.datos b{display:inline-block;min-width:7ch;color:var(--wine);font-weight:500;margin-right:10px}
#etiquetas{position:fixed;inset:0;pointer-events:none;z-index:4}
.et{position:absolute;left:0;top:0;text-align:center;white-space:nowrap;opacity:0;will-change:transform,opacity}
.et b{display:block;font-family:'Instrument Serif',serif;font-weight:400;font-size:clamp(20px,1.8vw,30px);line-height:1;color:#141011}
.et span{display:block;font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--mute);margin-top:4px}
.et.izq{text-align:left}
.et.chip{background:rgba(235,232,227,.9);padding:5px 9px 6px;border-radius:10px}
.con-etiquetas .datos{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);clip-path:inset(50%);white-space:nowrap}
@media (max-width:860px){
  section.scene{align-items:flex-start;padding-top:92px}
  .step h2{font-size:40px;margin:16px 0 12px}
  .step p{font-size:15px}
  .tag{margin-top:16px}
  .cta{margin-top:18px}
  .et b{font-size:19px}
  .hud.tl{display:none}
}
</style>
</head>
<body class="oscuro">
<div id="pre"><div class="mono" id="preTxt">chiq ░░░░░░░░░░░░ 000</div></div>
<div id="fotos" aria-hidden="true">
  <img id="f1" src="https://images.unsplash.com/photo-1543418219-44e30b057fea?w=2000&q=75" alt="">
  <img id="f2" src="https://images.unsplash.com/photo-1537640538966-79f369143f8f?w=2000&q=75" alt="" style="opacity:0">
  <div class="sombra" id="sombra"></div>
</div>
<div id="escarcha"></div>
<canvas id="gl" aria-hidden="true"></canvas>
<div id="etiquetas" aria-hidden="true"></div>
<div class="grain"></div>

<header>
  <a class="logo" href="/">Bodega Ejemplo</a>
  <nav aria-label="Principal">
    <a href="/">Historia</a><a href="/mercado/">El mercado en datos</a><a href="/como-esta-hecha/">Cómo está hecha</a>
    <button class="burger" id="burger" aria-label="Abrir menú"><i></i></button>
  </nav>
</header>
<div class="nota mono">Demo de chiq.es · Astro y motor propio WebGL2 (<span id="motorKB" class="ink">…</span>) · Bodega Ejemplo es ficticia</div>
<div class="hud tl mono"><span class="ink">Bodega Ejemplo</span><br>Demo · bodega ficticia</div>
<div class="hud tr mono">Datos del mercado<br><span class="ink">MAPA · 2025</span></div>
<div class="hud bl mono"><span id="hudIdx" class="ink">[00/06]</span>&nbsp; <span id="hudName">APERTURA</span></div>
<div class="hud br mono">Scroll <span id="hudPct" class="ink">000%</span></div>
<div class="rail" id="rail"><span class="on"></span><span></span><span></span><span></span><span></span><span></span><span></span></div>

<main>
  <section id="vuelo" data-name="APERTURA">
    <div class="pin">
      <div class="beat beat1" id="beat1">
        <p class="mono" style="color:rgba(244,239,232,.8);margin-bottom:34px">Bodega Ejemplo — una bodega ficticia</p>
        <h1>Cada botella empieza <em>en la cepa.</em></h1>
        <div class="cue mono">Scroll</div>
      </div>
      <div class="medio" id="medio"><span class="mono">Del campo al dato</span></div>
      <div class="beat beat2" id="beat2" style="opacity:0">
        <div class="caja">
          <p class="l">Una web de bodega que cuenta su historia <em>y enseña sus datos.</em></p>
          <span class="mono">Demo de chiq.es · los datos de la bodega son ficticios</span>
        </div>
      </div>
    </div>
  </section>

  <section class="scene" data-name="LAS AÑADAS"><div class="step">
    <div class="n mono fade"><b>01</b> Las añadas</div>
    <h2 class="split">Cada añada, <em>su propia historia.</em></h2>
    <p class="fade">Cada probeta es una añada y se llena con las botellas que dio. La lluvia del año explica el resto.</p>
    <ul class="datos mono fade">{B.anadas.map((a) => <li><b>{a.anio}</b>{miles(a.botellas)} botellas · {a.lluvia_mm} mm de lluvia · {a.nota}</li>)}</ul>
    <span class="tag mono fade">Datos ficticios</span>
  </div></section>
  <section class="scene" data-name="AL MUNDO"><div class="step">
    <div class="n mono fade"><b>02</b> Al mundo</div>
    <h2 class="split">De la ladera <em>al mundo.</em></h2>
    <p class="fade">Cada grupo de partículas es un país, del tamaño de su parte de las ventas.</p>
    <ul class="datos mono fade">{B.mercados.map((m) => <li><b>{m.pct} %</b>{m.pais}</li>)}</ul>
    <span class="tag mono fade">Datos ficticios</span>
  </div></section>
  <section class="scene" data-name="EL CLIENTE"><div class="step">
    <div class="n mono fade"><b>03</b> El cliente</div>
    <h2 class="split">El cliente es <em>el dato.</em></h2>
    <p class="fade">Distribución, tienda, club y visitas giran alrededor del mismo cliente. Cada nodo pesa lo que factura.</p>
    <ul class="datos mono fade">{B.canales.map((c) => <li><b>{c.pct} %</b>{c.canal}</li>)}<li><b>Club</b>{B.paso_club}</li></ul>
    <span class="tag mono fade">Datos ficticios</span>
  </div></section>
  <section class="scene" data-name="LA RUEDA DE AROMAS"><div class="step">
    <div class="n mono fade"><b>04</b> En la copa</div>
    <h2 class="split">Lo que hay <em>en la copa.</em></h2>
    <p class="fade">La rueda de aromas del {B.vino.nombre}. Cada porción crece con su intensidad, del 0 al 10.</p>
    <ul class="datos mono fade">{B.vino.aromas.map((a) => <li><b>{a.intensidad}</b>{a.aroma}</li>)}</ul>
    <span class="tag mono fade">Datos ficticios</span>
  </div></section>
  <section class="scene" data-name="CADA BOTELLA"><div class="step">
    <div class="n mono fade"><b>05</b> Cada botella</div>
    <h2 class="split">Cada botella, <em>con su ficha.</em></h2>
    <p class="fade">La ficha vive en PrestaShop y la web la lee por su API. Así también un asistente de IA entiende cada vino.</p>
    <ul class="datos mono fade"><li><b>Vino</b>{B.vino.nombre} · {B.vino.formato}</li><li><b>Precio</b>{B.vino.precio}</li><li><b>Stock</b>{miles(B.vino.stock)} botellas</li></ul>
    <span class="tag mono fade">Datos ficticios · en la demo, un JSON imita la API</span>
  </div></section>
  <section class="scene" data-name="SIN CABEZA"><div class="step">
    <div class="n mono fade"><b>06</b> Una web sin cabeza</div>
    <h2 class="split">Una web <em>sin cabeza.</em></h2>
    <p class="fade">Astro junta la historia, los datos y la tienda en páginas rápidas que Google y la IA leen enteras.</p>
    <a class="cta fade" href="/como-esta-hecha/"><span class="ar">→</span>Cómo está hecha</a>
  </div></section>

  <section class="gal" id="gal">
    <div class="gal-in">
      <div class="gal-head"><h3>Bodega Ejemplo</h3><span class="mono" style="color:var(--mute)">Desliza →</span></div>
      <div class="track" id="track">
        <a class="panel" href="/"><div class="ph" style="background-image:url(https://images.unsplash.com/photo-1537640538966-79f369143f8f?w=900&q=60)"></div><span class="idx mono">/01</span><h4>Historia</h4><p>Del viñedo a la botella, contado con scroll.</p></a>
        <a class="panel" href="/mercado/"><span class="idx mono">/02</span><span class="new mono">Datos reales</span><h4>El mercado</h4><p>Qué parte del vino compra cada edad, con su fuente (MAPA).</p></a>
        <a class="panel" href="/como-esta-hecha/"><span class="idx mono">/03</span><h4>Cómo está hecha</h4><p>Astro, datos en JSON y la tienda en PrestaShop por API.</p></a>
        <div class="panel"><div class="ph" style="background-image:url(https://images.unsplash.com/photo-1543418219-44e30b057fea?w=900&q=60)"></div><span class="idx mono">/04</span><span class="new mono">Próximamente</span><h4>Tienda</h4><p>Los vinos de la bodega, servidos por PrestaShop.</p></div>
        <div class="panel"><span class="idx mono">/05</span><span class="new mono">Próximamente</span><h4>Visitas</h4><p>Enoturismo con reserva y su dato.</p></div>
        <div class="panel"><span class="idx mono">/06</span><span class="new mono">Próximamente</span><h4>Club</h4><p>Socios, envíos y lo que les gusta.</p></div>
      </div>
    </div>
  </section>
</main>

<footer>
  <p class="big">Cada botella empieza <em>en la cepa.</em></p>
  <div class="cols">
    <div><span class="mono">Bodega Ejemplo</span><a href="/">Historia</a><a href="/mercado/">El mercado en datos</a><a href="/como-esta-hecha/">Cómo está hecha</a></div>
    <div><span class="mono">La demo</span><span class="pie-t">Bodega Ejemplo es una bodega ficticia. Esta web es una demo de chiq.es y no vende nada.</span></div>
    <div><span class="mono">Datos</span><span class="pie-t">MAPA · Panel de Consumo Alimentario en Hogares, con la fuente de cada cifra en su gráfico.</span></div>
    <div><span class="mono">Imágenes</span><span class="pie-t">Fotos de viñedo de Unsplash, provisionales.</span><span class="mono" style="display:block;margin-top:14px">© 2026 chiq.es</span></div>
  </div>
</footer>

<div id="menu" aria-hidden="true">
  <button class="close mono" id="close">Cerrar</button>
