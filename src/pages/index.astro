/* ---------- scroll ---------- */
// En pantallas táctiles, scroll nativo: el suavizado no aporta y desplaza los saltos a cada paso.
let lenis = null; if (!matchMedia('(pointer: coarse)').matches) { try { lenis = new Lenis({ lerp: 0.085, smoothWheel: true }); } catch (e) {} }
const vuelo = document.getElementById('vuelo'), f1 = document.getElementById('f1'), f2 = document.getElementById('f2'), sombra = document.getElementById('sombra');
const fotos = document.getElementById('fotos'), escarcha = document.getElementById('escarcha');
const b1 = document.getElementById('beat1'), b2 = document.getElementById('beat2'), medio = document.getElementById('medio');
const escenas = [...document.querySelectorAll('section.escena')], pasosNav = [...document.querySelectorAll('.recorrido span')];
const gal = document.getElementById('gal'), track = document.getElementById('track');
let raton = [0, 0], ratonS = [0, 0]; addEventListener('pointermove', (e) => { raton = [e.clientX / innerWidth - 0.5, e.clientY / innerHeight - 0.5]; });
let m = 0, activo = -2, ultimo = scrollY, vel = 0, oscuro = true, uFoto = 1, formaTexto = -1;

function objetivoM(y) {
  const finVuelo = vuelo.offsetTop + vuelo.offsetHeight - innerHeight;
  if (y <= finVuelo) return suave(tramo(y / finVuelo, 0.76, 0.98));
  // Cada escena está fija mientras dura su sección: una de un paso reposa en su forma; una larga reparte sus pasos.
  const anc = [[finVuelo, 1]];
  escenas.forEach((sec, s) => { const n = PLAN[s].n, a = sec.offsetTop, b = sec.offsetTop + sec.offsetHeight - innerHeight;
    if (n === 1) { anc.push([a, inicio[s]]); anc.push([b, inicio[s]]); }
    else for (let j = 0; j < n; j++) anc.push([a + (b - a) * j / (n - 1), inicio[s] + j]); });
  for (let i = 0; i < anc.length - 1; i++) if (y < anc[i + 1][0]) {
    if (anc[i][1] === anc[i + 1][1]) return anc[i][1];
    const p = (y - anc[i][0]) / (anc[i + 1][0] - anc[i][0]), misma = escenaDe[anc[i][1]] >= 0 && escenaDe[anc[i][1]] === escenaDe[anc[i + 1][1]];
    // Dentro de una escena larga, el objetivo salta al paso más cercano: la escena se desliza hasta él y reposa.
    return anc[i][1] + (misma ? Math.round(p) : p);
  }
