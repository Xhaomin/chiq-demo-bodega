  { n: 2, forma: (j) => ladera(j === 1), vista: { d: { x: 2.15, y: -0.3, s: 1.15 }, m: { x: 0, y: -1.35, s: 0.62 } } },
  { n: B.vinos.length, forma: (j) => ruedaVino(j), vista: { d: { x: 2.2, y: 0, s: 1 }, m: { x: 0, y: -1.1, s: 0.5 } } },
  { n: 1, forma: () => BODEGA.pos, color: () => BODEGA.col, vista: { d: { x: 2.05, y: 0, s: 0.98 }, m: { x: 0, y: -1.15, s: 0.56 } } },
  { n: 1, forma: () => botella(), vista: { d: { x: 2.2, y: 0, s: 1 }, m: { x: 0, y: -1.2, s: 0.45 } } },
  { n: 1, forma: () => botella(), vista: { d: { x: 2.3, y: 0, s: 1 }, m: { x: 0, y: -1.15, s: 0.55 } } },   // el sello, cuando estén las fuentes
