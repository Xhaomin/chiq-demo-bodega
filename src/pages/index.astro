/* ---------- precarga ---------- */
const pre = document.getElementById('pre'), preTxt = document.getElementById('preTxt'), t0 = performance.now();
(function carga(t) {
  const p = Math.min(1, Math.max(0, (t - t0) / 1600)), n = Math.round(p * 12);
  preTxt.textContent = 'bodega ' + '▓'.repeat(n) + '░'.repeat(12 - n) + ' ' + String(Math.round(p * 100)).padStart(3, '0');
