   cada cuatro moléculas se va a las cepas de una parcela, que se ven más frondosas. Su sitio en el relieve es de la maqueta. */
const SITIO = { 'El Cerro': [0.35, -0.25], 'La Hoya': [-0.6, 0.3], 'La Cuesta': [-1.35, -0.45], 'Los Llanos': [1.4, 0.55] };
const PARCELAS = B.terruno.parcelas.map((p, k) => { const s = SITIO[p.nombre] || [k * 0.8 - 1.2, 0]; return { ...p, x: s[0], z: s[1] }; });
const INCL = 0.38;
const altura = (x, z) => 0.95 * Math.exp(-((x - 0.35) ** 2 / 1.1 + (z + 0.15) ** 2 / 0.7)) + 0.42 * Math.exp(-((x + 1.25) ** 2 / 0.35 + (z - 0.55) ** 2 / 0.45)) + 0.05 * Math.sin(2.6 * x + 1.3 * z);
const enLadera = (x, z, dy = 0) => giroX([x, -0.75 + altura(x, z) + dy, z], INCL);
const FILA = 0.21, CEPA = 0.14;
function ladera(conParcelas) {
  const a = new Float32Array(N * 3), np = PARCELAS.length;
  for (let i = 0; i < N; i++) { const g = U1[i], ph = U2[i] * Math.PI * 2, r = Math.sqrt(U3[i]);
    if (g < 0.18) { a.set(enLadera(Math.cos(ph) * 2.3 * r, Math.sin(ph) * 1.5 * r), i * 3); continue; }   // el suelo
    let x, z;
    if (conParcelas && g < 0.46) { const p = PARCELAS[i % np]; x = p.x + Math.cos(ph) * r * 0.36; z = p.z + Math.sin(ph) * r * 0.26; }
    else { x = Math.cos(ph) * 2.3 * r; z = Math.sin(ph) * 1.5 * r; }
