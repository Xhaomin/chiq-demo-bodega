function sello() {
  const c = document.createElement('canvas'), W = 600, H = 400; c.width = W; c.height = H; const g = c.getContext('2d');
  g.font = 'italic 500 260px "Newsreader"'; g.textAlign = 'center'; g.textBaseline = 'middle'; g.fillText(B.iniciales, W / 2, H / 2);
  const d = g.getImageData(0, 0, W, H).data, letras = [];
  for (let y = 0; y < H; y += 2) for (let x = 0; x < W; x += 2) if (d[(y * W + x) * 4 + 3] > 128) letras.push([(x - W / 2) / 200, -(y - H / 2) / 200]);
  const a = new Float32Array(N * 3), col = new Float32Array(N * 3);
