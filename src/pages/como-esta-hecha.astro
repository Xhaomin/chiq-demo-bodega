---
// Página estática: explica la arquitectura de la demo. El fragmento de código es el de verdad (src/pages/mercado.astro).
const codigo = `---
import capitulo from '../data/capitulos/e2-brecha.json';
import apiladas from '../data/graficos/cuota-volumen-edad.json';
const DATOS = { capitulo, graficos: { 'cuota-volumen-edad': apiladas, … } };
---
<script id="datos-e2" type="application/json" set:html={JSON.stringify(DATOS)} />`;

const fuentes = [
  {
    n: '01',
    titulo: 'Historia',
    texto: 'Textos e imágenes de la bodega, guardados en el repositorio junto al código. En esta demo, las fotos son provisionales (Unsplash).',
  },
  {
    n: '02',
    titulo: 'Datos',
    texto: 'El modelo de evidencia de chiq.es lee el Excel oficial del MAPA, contrasta cada serie con sus informes publicados y exporta un JSON por gráfico, con la fuente y la celda de la que sale cada cifra.',
  },
  {
    n: '03',
    titulo: 'Tienda sin cabeza',
    texto: 'PrestaShop guarda el catálogo, el stock y los pedidos. La web lee las fichas de cada vino por su API y las publica como páginas. En esta demo la tienda aún no está conectada.',
  },
];

const porque = [
  ['Rápida y legible', 'Páginas HTML ya hechas. Cargan al momento y Google y los asistentes de IA leen cada texto y cada cifra.'],
  ['Cada dato, con su fuente', 'Ninguna cifra se escribe a mano. Si el dato cambia, la página cambia al publicar, y si deja de cuadrar no se publica.'],
  ['El cliente es el dato', 'Tienda, club y visitas comparten al mismo cliente. La bodega es dueña de ese dato, no un marketplace.'],
];
---
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Cómo está hecha · Bodega Ejemplo · demo de chiq.es</title>
<meta name="robots" content="noindex, nofollow">
<meta name="description" content="Arquitectura de la demo de Bodega Ejemplo (ficticia) de chiq.es: Astro, datos en JSON y tienda sin cabeza.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter+Tight:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style is:global>
:root{--bg:#ebe8e3;--ink:#141011;--wine:#6e1432;--rose:#a3456a;--mute:#6f6763;--line:rgba(20,16,17,.14)}
*{box-sizing:border-box;margin:0;padding:0}
body{background:var(--bg);color:var(--ink);font-family:'Inter Tight',system-ui,sans-serif;-webkit-font-smoothing:antialiased}
.mono{font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.12em;text-transform:uppercase}
a{color:inherit}
header{position:sticky;top:0;z-index:10;display:flex;justify-content:space-between;align-items:center;padding:22px clamp(16px,3vw,32px);background:rgba(235,232,227,.9);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
.logo{font-family:'Instrument Serif',serif;font-size:26px;text-decoration:none;letter-spacing:-.02em}
nav{display:flex;gap:22px;flex-wrap:wrap;justify-content:flex-end}
nav a{text-decoration:none;font-size:14px}
nav a[aria-current]{border-bottom:1px solid var(--ink)}
main{max-width:1180px;margin:0 auto;padding:0 clamp(16px,3vw,32px)}
.apertura{padding:clamp(70px,14vh,150px) 0 clamp(40px,8vh,80px)}
.apertura .mono{color:var(--mute)}
h1{font-family:'Instrument Serif',serif;font-weight:400;font-size:clamp(52px,8vw,128px);line-height:.92;letter-spacing:-.035em;margin:22px 0 28px;max-width:12ch}
h1 em,h2 em{font-style:italic;color:var(--wine)}
.entradilla{font-size:clamp(18px,1.6vw,22px);line-height:1.5;max-width:52ch;color:#3a3334}
.esquema{display:grid;grid-template-columns:1fr auto 1.1fr auto 1fr;gap:18px;align-items:stretch;margin:30px 0 90px}
.col{display:flex;flex-direction:column;gap:14px}
.caja{background:rgba(255,255,255,.5);border:1px solid rgba(255,255,255,.85);border-radius:18px;padding:20px 22px;box-shadow:0 30px 60px -40px rgba(20,16,17,.35)}
.caja h3{font-family:'Instrument Serif',serif;font-weight:400;font-size:30px;letter-spacing:-.02em;margin:8px 0 8px}
.caja p{font-size:14.5px;line-height:1.55;color:#3a3334}
.caja .mono{color:var(--rose)}
.centro{background:var(--ink);color:#f4efe8;border-color:var(--ink)}
.centro p{color:#d9d1ca}
.centro .mono{color:#e59ab7}
.flecha{align-self:center;font-family:'Instrument Serif',serif;font-size:44px;color:var(--wine)}
pre{margin-top:14px;background:#1d1719;color:#eadfd8;border-radius:12px;padding:14px 16px;overflow-x:auto;font-family:'JetBrains Mono',monospace;font-size:11.5px;line-height:1.6}
h2{font-family:'Instrument Serif',serif;font-weight:400;font-size:clamp(40px,5vw,76px);letter-spacing:-.03em;line-height:.95;margin:0 0 30px}
.porque{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-bottom:100px}
.porque h3{font-family:'Instrument Serif',serif;font-weight:400;font-size:32px;margin-bottom:10px;letter-spacing:-.02em}
.porque p{font-size:15px;line-height:1.55;color:#3a3334}
.porque div{border-top:1px solid var(--ink);padding-top:16px}
.seguir{display:flex;gap:28px;flex-wrap:wrap;padding:0 0 90px;font-family:'Instrument Serif',serif;font-size:clamp(26px,3vw,40px)}
.seguir a{text-decoration:none;border-bottom:1px solid var(--line)}
footer{border-top:1px solid var(--line);padding:28px clamp(16px,3vw,32px) 40px;color:var(--mute);font-size:13px;line-height:1.6}
@media (max-width:900px){
  .esquema{grid-template-columns:1fr}
  .flecha{transform:rotate(90deg);justify-self:center}
  .porque{grid-template-columns:1fr}
}
</style>
</head>
<body>
<header>
  <a class="logo" href="/">Bodega Ejemplo</a>
  <nav aria-label="Principal">
    <a href="/">Historia</a><a href="/mercado/">El mercado en datos</a><a href="/como-esta-hecha/" aria-current="page">Cómo está hecha</a>
  </nav>
</header>
<main>
  <section class="apertura">
    <p class="mono">Demo de chiq.es · Bodega Ejemplo es ficticia</p>
    <h1>Cómo está hecha <em>esta web.</em></h1>
    <p class="entradilla">Una web de bodega rápida, que cuenta su historia y sus datos, con la tienda detrás. Cada pieza vive donde mejor se gestiona y Astro las junta al publicar.</p>
  </section>

  <section class="esquema" aria-label="Esquema de la arquitectura">
    <div class="col">
      {fuentes.map((f) => (
        <div class="caja"><span class="mono">{f.n} · Fuente</span><h3>{f.titulo}</h3><p>{f.texto}</p></div>
      ))}
    </div>
    <span class="flecha" aria-hidden="true">→</span>
    <div class="col">
      <div class="caja centro">
        <span class="mono">Astro · al publicar</span>
        <h3>Compila páginas HTML</h3>
        <p>Junta la historia, los datos y las fichas de la tienda en páginas ya hechas. No hay servidor de aplicaciones que mantener y las cifras van en el HTML, no en un lienzo.</p>
        <pre><code>{codigo}</code></pre>
      </div>
      <div class="caja">
        <span class="mono">Capa de experiencia</span>
        <h3>Vuelo y partículas</h3>
        <p>Motor propio en WebGL2, de unos 4 KB, y scroll suave. Es decorativo. El texto y las cifras están en el HTML.</p>
      </div>
    </div>
    <span class="flecha" aria-hidden="true">→</span>
    <div class="col">
      <div class="caja"><span class="mono">Publicación</span><h3>Servidor propio</h3><p>Una imagen Docker con Caddy, desplegada con Coolify en un servidor propio y servida por el túnel de Cloudflare en demo.chiq.es.</p></div>
      <div class="caja"><span class="mono">Quién la lee</span><h3>Personas, Google e IA</h3><p>El visitante ve la experiencia. Google y los asistentes de IA leen el mismo HTML, con cada vino y cada cifra.</p></div>
    </div>
  </section>

  <h2>Por qué así, <em>para una bodega.</em></h2>
  <section class="porque">
    {porque.map(([t, p]) => (<div><h3>{t}</h3><p>{p}</p></div>))}
  </section>

  <nav class="seguir" aria-label="Seguir">
    <a href="/">← Volver a la historia</a>
    <a href="/mercado/">El mercado en datos →</a>
  </nav>
</main>
<footer>
  Bodega Ejemplo es una bodega ficticia. Esta web es una demo de chiq.es y no vende nada. Datos del mercado del MAPA, Panel de Consumo Alimentario en Hogares. Fotos de viñedo de Unsplash, provisionales. © 2026 chiq.es
</footer>
</body>
</html>
