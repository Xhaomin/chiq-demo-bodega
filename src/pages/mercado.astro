<script id="datos-e2" type="application/json" is:inline set:html={DATOS_JSON}></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/lenis@1.1.13/dist/lenis.min.js"></script>
<script is:inline type="module">
/* ============================================================================================
   Maqueta del capítulo E2. Todo texto con cifra sale de DATOS (contratos grafico.v2 y capitulo.v1
   imitados por docs/maquetas/capitulo-e2-datos.py). Aquí solo hay maquetación y comportamiento.
   ============================================================================================ */
const DATOS = JSON.parse(document.getElementById('datos-e2').textContent);
const CAP = DATOS.capitulo, G = DATOS.graficos;
const LIN = G['brecha-litros-persona-menos35'], API = G['cuota-volumen-edad'];
const clamp = (v, a = 0, b = 1) => Math.min(b, Math.max(a, v));
const tramo = (p, a, b) => clamp((p - a) / (b - a));
const suave = (x) => x * x * (3 - 2 * x);
const esc = (t) => String(t).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
const $ = (id) => document.getElementById(id);
const SIN_MOV = matchMedia('(prefers-reduced-motion: reduce)').matches;
if (SIN_MOV) document.documentElement.classList.add('sin-movimiento');

/* ---------- piezas del capítulo (las mismas funciones que la plantilla del plan B, Tarea 16) ---------- */
const periodos = (g) => [...new Set(g.series.flatMap((s) => s.puntos.map((p) => p.periodo)))].sort((a, b) => a - b);
const todos = [LIN, API];
const pers = todos.flatMap(periodos), DESDE = Math.min(...pers), HASTA = Math.max(...pers);
const PERIODO = `${DESDE}–${HASTA}`;
const sigla = (org) => (org.match(/\(([^)]+)\)/) || [, org])[1];
const nombreCap = (slug) => { const t = slug.replace(/-/g, ' '); return t[0].toUpperCase() + t.slice(1); };
const ESTADOS = { C: 'Confirmado', H: 'Hipótesis', F: 'Falta el dato' };
const estado = (e) => `<span class="estado mono" title="${ESTADOS[e]}">[${e}] ${ESTADOS[e]}</span>`;
/** Nombres cortos para leyendas y etiquetas: la etiqueta de cada serie sin el prefijo común a todas. */
function cortas(series) {
  const et = series.map((s) => s.etiqueta);
  let k = 0; while (et.every((e) => e[k] === et[0][k])) k++;
  const pref = et[0].slice(0, k).replace(/\S*$/, '');
  return et.map((e) => { const c = e.slice(pref.length); return c[0].toUpperCase() + c.slice(1); });
}
const conPunto = (t) => (/[.!?…]$/.test(t) ? t : `${t}.`);

$('hudCap').textContent = `Obs_${String(CAP.orden).padStart(2, '0')} / ${nombreCap(CAP.slug)}`;
$('hudFuente').textContent = `${sigla(LIN.fuente.organismo)} · ${PERIODO}`;
$('hudAct').textContent = `${sigla(LIN.fuente.organismo)} · ${HASTA}`;
$('sello').textContent = `Datos actualizados · ${sigla(LIN.fuente.organismo)} ${HASTA}`;
$('kicker').textContent = `Estudio · Capítulo ${String(CAP.orden).padStart(2, '0')}${CAP.publicado ? '' : ' · Borrador'}`;
{ // título fijo: la última palabra en cursiva granate
  const t = CAP.titulo.texto, i = t.lastIndexOf(' ');
  $('titulo').innerHTML = `${esc(t.slice(0, i))} <em>${esc(t.slice(i + 1))}.</em>`;
}
$('respuesta').textContent = CAP.respuesta.texto;
// «Ver de dónde sale» lleva al gráfico cuya afirmación es la respuesta directa
const graficoRespuesta = CAP.graficos.find((id) => G[id].afirmaciones.some((a) => a.id === CAP.respuesta.id));
$('lineaRespuesta').innerHTML = `<span>${esc(LIN.fuente.organismo)} · ${PERIODO}</span>${estado(CAP.respuesta.estado)}<a href="#g-${graficoRespuesta}">Ver de dónde sale ↓</a>`;

/* ---------- gráficos SVG (en la web se generan al compilar; aquí, al cargar) ---------- */
const COL_LIN = ['var(--wine)', 'var(--mute)'];
const COL_API = ['var(--t0)', 'var(--t1)', 'var(--t2)', 'var(--t3)'];
const RUPT = { base: 'Cambio de base INE', recalibracion: 'Recalibración MAPA', metodo: 'Cambio de método', nomenclatura: 'Cambio de nombres' };
const fmt = new Intl.NumberFormat('es-ES', { maximumFractionDigits: 1 });
function escalaBonita(max, marcas = 5) {
  const bruto = max / marcas, pot = 10 ** Math.floor(Math.log10(bruto));
  const paso = [1, 2, 2.5, 5, 10].map((m) => m * pot).find((p) => p >= bruto);
  const tope = Math.ceil(max / paso) * paso;
  return { tope, marcas: Array.from({ length: Math.round(tope / paso) + 1 }, (_, i) => i * paso) };
}
const punto = (s, per) => s.puntos.find((p) => p.periodo === per);

function bloque(g, num, sec) {
  const nombres = cortas(g.series), cols = g.tipo === 'lineas' ? COL_LIN : COL_API;
  const hayEmp = g.series.some((s) => s.puntos.some((p) => p.empalme));
  const af = g.afirmaciones[0];
  const leyenda = g.series.map((s, i) => `<li><span class="m ${g.tipo === 'lineas' ? '' : 'b'}" style="background:${cols[i]}"></span>${esc(nombres[i])}</li>`).join('')
    + (hayEmp && g.tipo === 'lineas' ? `<li><span class="m h"></span><span class="m p"></span>Valor en la otra base de población (años de empalme)</li>` : '')
    + (hayEmp && g.tipo === 'apiladas' ? `<li><span class="ast">*</span>Año con las dos bases de población; el valor en la otra base, en la tabla</li>` : '');
  // Magnitud de cada ruptura, agrupada por serie: «Menor de 35 años: −14,8 % en 2022 y −22,5 % en 2023».
  const magn = (per) => g.series.flatMap((s, i) => s.rupturas.filter((r) => r.periodo === per && r.magnitud)
    .map((r) => `${nombres[i]}: ${r.magnitud.map((m) => `${m.texto} en ${m.periodo}`).join(' y ')}`));
  const rupturas = g.rupturas.map((r) => { const m = magn(r.periodo);
    return `<li>Ruptura ${r.periodo}: ${esc(conPunto(r.nota))}${m.length ? `<span class="magnitud"> Diferencia entre bases (nueva frente a anterior): ${esc(m.join('; '))}.</span>` : ''}</li>`; }).join('');
  const pers = periodos(g);
  const tabla = `<div class="tabla-scroll"><table><caption>${esc(g.pregunta)} (${esc(g.unidad)})</caption><thead><tr><th scope="col">Año</th>${nombres.map((n) => `<th scope="col">${esc(n)}</th>`).join('')}</tr></thead><tbody>`
    + pers.map((per) => `<tr><th scope="row">${per}</th>${g.series.map((s) => { const p = punto(s, per);
      return `<td>${p ? esc(p.texto) : '—'}${p?.empalme ? `<small>${esc(p.empalme.texto)} en base ${esc(p.empalme.base)}</small>` : ''}</td>`; }).join('')}</tr>`).join('')
    + `</tbody></table></div>`;
  const proc = g.series.flatMap((s, i) => s.puntos.map((p) => `<dt>${esc(nombres[i])} · ${p.periodo}</dt><dd><ul>`
    + p.procedencia.map((c) => `<li><code>${esc(c.fichero)}</code> · hoja «${esc(c.hoja)}» · fila ${c.fila} · columna ${c.columna} · SHA-256 <code>${esc(c.sha256.slice(0, 12))}…</code></li>`).join('')
    + (p.empalme ? p.empalme.procedencia.map((c) => `<li>En base ${esc(p.empalme.base)}: <code>${esc(c.fichero)}</code> · fila ${c.fila} · columna ${c.columna}</li>`).join('') : '')
    + `</ul>Base de población: ${esc(p.base)}</dd>`)).join('');
  const provisional = g.series.some((s) => s.provisional)
    ? `` : '';
  const covid = g.tipo === 'lineas'
    ? `` : '';
  sec.innerHTML = `
    <p class="n mono fade"><b>0${num}</b> ${esc(sec.dataset.name[0] + sec.dataset.name.slice(1).toLowerCase())}</p>
    <h2 class="split">${esc(g.pregunta)}</h2>
    <p class="afirmacion fade">${esc(af.texto)}${estado(af.estado)}</p>
    <figure class="panel fade" id="grafico-${g.id}" aria-labelledby="t-${g.id}">
      <ul class="leyenda">${leyenda}</ul>
      <div class="lienzo" data-grafico="${g.id}"></div>
      <figcaption>
        <span class="hud-f mono" id="t-${g.id}">${esc(g.fuente.organismo)} · ${esc(g.unidad)} · ${pers[0]}–${pers.at(-1)}</span>
        <ul class="rupturas">${rupturas}</ul>
      </figcaption>
      <details><summary class="mono">Tabla de datos</summary>${tabla}</details>
      <details class="procedencia" data-evento-abrir="procedencia_abierta" data-prop-grafico="${g.id}"><summary class="mono">Procedencia de cada cifra</summary>
        <dl><dt>Universo</dt><dd>${esc(g.universo.descripcion)}</dd><dt>Fuente</dt><dd><a href="${esc(g.fuente.url)}" rel="noopener">${esc(g.fuente.organismo)} · ${esc(g.fuente.titulo)}</a></dd>
        <dt>Licencia de la fuente</dt><dd>${esc(g.fuente.licencia ?? 'Pendiente de verificar [F]')}</dd>${proc}<dt>Revisado</dt><dd>${esc(g.revisado)}</dd></dl></details>
      <a class="ficha" href="#"><span class="ar">→</span>Ficha del gráfico, tabla y CSV</a>
    </figure>${covid}${provisional}`;
}
CAP.graficos.forEach((id, i) => {
  const sec = document.createElement('section');
  sec.className = 'bloque pad'; sec.id = `g-${id}`; sec.dataset.name = G[id].unidad.toUpperCase();
  $('graficos').appendChild(sec); bloque(G[id], i + 1, sec);
});

/** Tooltip común: se coloca junto al puntero dentro del lienzo. */
function tooltip(lienzo) {
  const tip = document.createElement('div'); tip.className = 'tip'; lienzo.appendChild(tip);
  return {
    ver(html, x, y) { tip.innerHTML = html; tip.style.opacity = 1;
      const w = tip.offsetWidth, W = lienzo.clientWidth; tip.style.left = `${Math.min(W - w, Math.max(0, x + 16))}px`; tip.style.top = `${Math.max(0, y - 20)}px`; },
    ocultar() { tip.style.opacity = 0; },
  };
}
const filaTip = (col, nombre, p) => `<div class="f"><span><i style="background:${col}"></i>${esc(nombre)}</span><span>${esc(p.texto)}</span></div>${p.empalme ? `<small>${esc(p.empalme.texto)} en base ${esc(p.empalme.base)}</small>` : ''}`;

function dibujarLineas(g) {
  const lienzo = document.querySelector(`[data-grafico="${g.id}"]`), W = lienzo.clientWidth, estrecho = W < 560;
  const H = estrecho ? 300 : 420, M = { t: 30, r: estrecho ? 44 : 64, b: 36, l: estrecho ? 26 : 34 };
  const pers = periodos(g), nombres = cortas(g.series);
  const x = (per) => M.l + (pers.indexOf(per) / (pers.length - 1)) * (W - M.l - M.r);
  const vals = g.series.flatMap((s) => s.puntos.flatMap((p) => (p.empalme ? [p.valor, p.empalme.valor] : [p.valor])));
  const { tope, marcas } = escalaBonita(Math.max(...vals), 5);
  const y = (v) => H - M.b - (v / tope) * (H - M.t - M.b);
  let s = `<svg viewBox="0 0 ${W} ${H}" role="img" aria-labelledby="t-${g.id}"><title>${esc(g.pregunta)}</title><desc>${esc(g.afirmaciones[0].texto)}</desc><g class="eje">`;
  marcas.forEach((m) => { s += `<line x1="${M.l}" x2="${W - M.r}" y1="${y(m)}" y2="${y(m)}" stroke="rgba(20,16,17,${m === 0 ? .3 : .1})"/><text x="${M.l - 8}" y="${y(m) + 4}" text-anchor="end">${fmt.format(m)}</text>`; });
  pers.forEach((per, i) => { if (!estrecho || i % 3 === 0 || i === pers.length - 1) s += `<text x="${x(per)}" y="${H - M.b + 22}" text-anchor="middle">${per}</text>`; });
  s += `</g><g class="rup">`;
  g.rupturas.forEach((r) => { const xr = (x(r.periodo) + x(r.periodo - 1)) / 2;
    s += `<line x1="${xr}" x2="${xr}" y1="${M.t - 8}" y2="${H - M.b}" stroke="var(--wine)" stroke-opacity=".45" stroke-dasharray="3 4"/>${estrecho ? '' : `<text x="${xr + 6}" y="${M.t - 2}">${esc(RUPT[r.tipo])} · ${r.periodo}</text>`}`; });
  s += `</g>`;
  g.series.forEach((se, i) => {
    const col = COL_LIN[i], tramos = [];
    se.puntos.forEach((p, k) => { const prev = se.puntos[k - 1]; if (!prev || prev.base !== p.base) tramos.push([]); tramos.at(-1).push(p); });
    tramos.forEach((t) => { s += `<path d="${t.map((p, k) => `${k ? 'L' : 'M'}${x(p.periodo)},${y(p.valor)}`).join('')}" fill="none" stroke="${col}" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/>`; });
    // empalme: continuación en la base anterior, punteada y con puntos huecos
    const emp = se.puntos.filter((p) => p.empalme);
    if (emp.length) { const ultimo = [...se.puntos].reverse().find((p) => p.base === emp[0].empalme.base && p.periodo < emp[0].periodo);
      const cad = [ultimo ? [ultimo.periodo, ultimo.valor] : null, ...emp.map((p) => [p.periodo, p.empalme.valor])].filter(Boolean);
      s += `<path d="${cad.map(([a, v], k) => `${k ? 'L' : 'M'}${x(a)},${y(v)}`).join('')}" fill="none" stroke="${col}" stroke-width="1.5" stroke-dasharray="1.5 4" stroke-linecap="round"/>`;
      emp.forEach((p) => { s += `<circle cx="${x(p.periodo)}" cy="${y(p.empalme.valor)}" r="4" fill="var(--bg)" stroke="${col}" stroke-width="1.5"><title>${p.periodo} · ${esc(nombres[i])} en base ${esc(p.empalme.base)}: ${esc(p.empalme.texto)} ${esc(g.unidad)}</title></circle>`; }); }
    const a = se.puntos[0], b = se.puntos.at(-1);
    [a, b].forEach((p, k) => { s += `<circle cx="${x(p.periodo)}" cy="${y(p.valor)}" r="5" fill="${col}" stroke="#f3f1ee" stroke-width="2"/>`
      + `<text class="valor" x="${x(p.periodo) + (k ? 10 : 2)}" y="${y(p.valor) + (k ? 5 : -12)}" text-anchor="start">${esc(p.texto)}</text>`; });
  });
  s += `<line id="cruz-${g.id}" y1="${M.t}" y2="${H - M.b}" stroke="var(--ink)" stroke-opacity=".35" visibility="hidden"/><rect x="${M.l}" y="${M.t}" width="${W - M.l - M.r}" height="${H - M.t - M.b}" fill="transparent"/></svg>`;
  lienzo.innerHTML = s;
  const tip = tooltip(lienzo), cruz = lienzo.querySelector(`#cruz-${g.id}`), zona = lienzo.querySelector('rect');
  zona.addEventListener('pointermove', (e) => {
    const r = lienzo.getBoundingClientRect(), px = e.clientX - r.left;
    const per = pers.reduce((m, p) => (Math.abs(x(p) - px) < Math.abs(x(m) - px) ? p : m), pers[0]);
    cruz.setAttribute('x1', x(per)); cruz.setAttribute('x2', x(per)); cruz.setAttribute('visibility', 'visible');
    tip.ver(`<b>${per}</b>${g.series.map((se, i) => filaTip(COL_LIN[i], nombres[i], punto(se, per))).join('')}`, x(per), e.clientY - r.top);
  });
  zona.addEventListener('pointerleave', () => { cruz.setAttribute('visibility', 'hidden'); tip.ocultar(); });
}

function dibujarApiladas(g) {
  const lienzo = document.querySelector(`[data-grafico="${g.id}"]`), W = lienzo.clientWidth, estrecho = W < 560;
  const H = estrecho ? 320 : 420, M = { t: 30, r: estrecho ? 8 : 20, b: 36, l: estrecho ? 30 : 38 };
  const pers = periodos(g), nombres = cortas(g.series), n = pers.length;
  const holgura = estrecho ? 44 : 70, barra = estrecho ? 14 : 24, hueco = 2;
  const x = (i) => M.l + holgura + (i / (n - 1)) * (W - M.l - M.r - 2 * holgura);
  const y = (v) => H - M.b - (v / 100) * (H - M.t - M.b);
  let s = `<svg viewBox="0 0 ${W} ${H}" role="img" aria-labelledby="t-${g.id}"><title>${esc(g.pregunta)}</title><desc>${esc(g.afirmaciones[0].texto)}</desc><g class="eje">`;
  [0, 25, 50, 75, 100].forEach((m) => { s += `<line x1="${M.l}" x2="${W - M.r}" y1="${y(m)}" y2="${y(m)}" stroke="rgba(20,16,17,${m === 0 ? .3 : .1})"/><text x="${M.l - 8}" y="${y(m) + 4}" text-anchor="end">${m}${estrecho ? '' : ' %'}</text>`; });
  pers.forEach((per, i) => { const emp = g.series.some((se) => punto(se, per)?.empalme);
    if (!estrecho || i % 3 === 0 || i === n - 1) s += `<text x="${x(i)}" y="${H - M.b + 22}" text-anchor="middle">${estrecho ? String(per).slice(2) : per}${emp ? '<tspan fill="var(--wine)">*</tspan>' : ''}</text>`; });
  s += `</g><g class="rup">`;
  g.rupturas.forEach((r) => { const i = pers.indexOf(r.periodo), xr = (x(i) + x(i - 1)) / 2;
    s += `<line x1="${xr}" x2="${xr}" y1="${M.t - 8}" y2="${H - M.b}" stroke="var(--wine)" stroke-opacity=".45" stroke-dasharray="3 4"/>${estrecho ? '' : `<text x="${xr + 6}" y="${M.t - 2}">${esc(RUPT[r.tipo])} · ${r.periodo}</text>`}`; });
  s += `</g>`;
  pers.forEach((per, i) => {
    let acum = 0; s += `<g class="col" data-i="${i}">`;
    g.series.forEach((se, k) => { const p = punto(se, per); const v0 = acum, v1 = acum + p.valor; acum = v1;
      const top = y(v1) + (k === g.series.length - 1 ? 0 : hueco / 2), bot = y(v0) - (k === 0 ? 0 : hueco / 2), h = Math.max(0, bot - top), xa = x(i) - barra / 2;
      s += k === g.series.length - 1
        ? `<path d="M${xa},${bot}V${top + 4}Q${xa},${top} ${xa + 4},${top}H${xa + barra - 4}Q${xa + barra},${top} ${xa + barra},${top + 4}V${bot}Z" fill="${COL_API[k]}"/>`
        : `<rect x="${xa}" y="${top}" width="${barra}" height="${h}" fill="${COL_API[k]}"/>`; });
    s += `<rect x="${x(i) - (W - M.l - M.r) / n / 2}" y="${M.t}" width="${(W - M.l - M.r) / n}" height="${H - M.t - M.b}" fill="transparent" data-zona="${i}"/></g>`;
  });
  // etiquetas directas selectivas: el tramo más joven (abajo) y el mayor (arriba), en el primer y el último año
  if (!estrecho) [0, n - 1].forEach((i) => { const per = pers[i], ult = i === n - 1;
    [0, g.series.length - 1].forEach((k) => { const p = punto(g.series[k], per);
      const base = g.series.slice(0, k).reduce((a, se) => a + punto(se, per).valor, 0);
      const yv = k === 0 ? Math.min(y(base + p.valor / 2), y(0) - 6) : y(base + p.valor / 2);
      s += `<text class="valor" x="${x(i) + (ult ? 1 : -1) * (barra / 2 + 10)}" y="${yv + 5}" text-anchor="${ult ? 'start' : 'end'}">${esc(p.texto)}</text>`; }); });
  s += `</svg>`;
  lienzo.innerHTML = s;
  const tip = tooltip(lienzo);
  lienzo.querySelectorAll('[data-zona]').forEach((z) => {
    z.addEventListener('pointermove', (e) => { const i = +z.dataset.zona, per = pers[i], r = lienzo.getBoundingClientRect();
      lienzo.querySelectorAll('.col').forEach((c) => c.style.opacity = +c.dataset.i === i ? 1 : .45);
      tip.ver(`<b>${per}</b>${[...g.series].reverse().map((se) => filaTip(COL_API[g.series.indexOf(se)], nombres[g.series.indexOf(se)], punto(se, per))).join('')}`, e.clientX - r.left, e.clientY - r.top); });
    z.addEventListener('pointerleave', () => { lienzo.querySelectorAll('.col').forEach((c) => c.style.opacity = 1); tip.ocultar(); });
  });
}
const dibujar = () => { dibujarLineas(LIN); dibujarApiladas(API); };
dibujar();
let rz; addEventListener('resize', () => { clearTimeout(rz); rz = setTimeout(dibujar, 150); });

/* ---------- cautelas: las de la respuesta y las de las afirmaciones, sin repetir ---------- */
{
  const lista = [...new Set([...CAP.respuesta.cautelas, ...todos.flatMap((g) => g.afirmaciones.flatMap((a) => a.cautelas))])];
  const sinControl = todos.flatMap((g) => g.afirmaciones.flatMap((a) => a.sin_control.map((s) => `Sin contraste con el informe publicado: ${s.serie}, ${s.periodo}. ${s.motivo}`)));
  $('listaCautelas').innerHTML = lista.map((t) => `<li>${esc(t)}</li>`).join('') + sinControl.map((t) => `<li class="sin-control">${esc(t)}</li>`).join('');
}

/* ---------- escena: textos de la escena desde el gráfico apilado ---------- */
const PERS_E = periodos(API), NOMBRES_E = cortas(API.series);
$('escenaPregunta').textContent = API.pregunta;
$('anioRef').textContent = PERS_E[0];
$('escena').dataset.name = `${PERS_E[0]} → ${PERS_E.at(-1)}`;
$('rupturasEscena').innerHTML = API.rupturas.map((r) => `<li data-p="${r.periodo}" title="${esc(r.nota)}"><b>${r.periodo}</b> · Ruptura · ${esc(RUPT[r.tipo])}</li>`).join('');
const etiquetas = $('etiquetas');
etiquetas.innerHTML = API.series.map((se, k) => `<div class="et" data-k="${k}"><span class="v" data-v></span><span class="n mono"><i style="background:${COL_API[k]}"></i>${esc(NOMBRES_E[k])}</span><span class="d mono">${PERS_E[0]} · ${esc(se.puntos[0].texto)}</span></div>`).join('');
const valEt = [...etiquetas.querySelectorAll('[data-v]')];
function mostrarAnio(idx) {
  const per = PERS_E[idx];
  $('anio').innerHTML = idx === PERS_E.length - 1 ? `<em>${per}</em>` : String(per);
  API.series.forEach((se, k) => { valEt[k].textContent = punto(se, per).texto; });
  document.querySelectorAll('#rupturasEscena li').forEach((li) => li.classList.toggle('si', per >= +li.dataset.p));
}
if (SIN_MOV) {
  $('anio').textContent = `${PERS_E[0]} → ${PERS_E.at(-1)}`;
  API.series.forEach((se, k) => { valEt[k].textContent = `${se.puntos[0].texto} → ${se.puntos.at(-1).texto}`; });
} else mostrarAnio(0);

/* ---------- texto partido y menú (igual que la home) ---------- */
document.querySelectorAll('.split').forEach((el) => {
  const frag = document.createDocumentFragment(); let k = 0;
  el.childNodes.forEach((n) => n.textContent.split(/(\s+)/).forEach((w) => {
    if (!w) return;
    if (/^\s+$/.test(w)) { frag.appendChild(document.createTextNode(' ')); return; }
    const o = document.createElement('span'); o.className = 'w';
    const i = document.createElement(n.nodeType === 1 ? n.tagName.toLowerCase() : 'span');
    i.textContent = w; i.style.transitionDelay = (k++ * 0.05) + 's'; o.appendChild(i); frag.appendChild(o);
  }));
  el.innerHTML = ''; el.appendChild(frag);
});
const io = new IntersectionObserver((es) => es.forEach((e) => e.isIntersecting && e.target.classList.add('in')), { threshold: 0.12 });
document.querySelectorAll('#apertura, section.bloque, #cautelas, #gancho').forEach((s) => io.observe(s));
const menu = $('menu');
$('burger').onclick = () => menu.classList.add('open');
$('close').onclick = () => menu.classList.remove('open');
addEventListener('keydown', (e) => { if (e.key === 'Escape') menu.classList.remove('open'); });
$('conmutador').onclick = (e) => { const on = document.body.classList.toggle('notas'); e.currentTarget.textContent = `Notas de maqueta · ${on ? 'sí' : 'no'}`; e.currentTarget.setAttribute('aria-pressed', on); };
const GLIFOS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789/_·#';
function descifrar(el, texto) {
  if (SIN_MOV) { el.textContent = texto; return; }
  const ini = performance.now();
  const paso = (t) => { const p = Math.min(1, (t - ini) / 520), fijas = Math.floor(p * texto.length);
    el.textContent = texto.split('').map((c, i) => (i < fijas || c === ' ') ? c : GLIFOS[(Math.random() * GLIFOS.length) | 0]).join('');
    if (p < 1) requestAnimationFrame(paso); };
  requestAnimationFrame(paso);
}

/* ============================================================================================
   Motor de partículas: el mismo de la home (WebGL2 directo) con dos cambios para el capítulo:
   el scroll lleva la escena año a año (cada cambio se anima y reposa) y el color va por tramo, con líquido y vidrio.
   ============================================================================================ */
const N = innerWidth > 860 ? 16000 : 8000;
const FOV = 34, DIST = 9.5;
function mulberry32(a) { return () => { a |= 0; a = (a + 0x6d2b79f5) | 0; let t = Math.imul(a ^ (a >>> 15), 1 | a); t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t; return ((t ^ (t >>> 14)) >>> 0) / 4294967296; }; }
const K = API.series.length, SEP = 0.95, RADIO = 0.3, ALTO = 3, SUELO = -1.5;
const XS = Array.from({ length: K }, (_, j) => (j - (K - 1) / 2) * SEP);
/** Probetas: cada partícula tiene su altura fija (semilla). Un 26 % dibuja el vidrio y un 4 % la marca del nivel de
 * referencia (2016). El resto es líquido si su altura queda bajo el nivel del año y, si no, forma el anillo de la
 * superficie a ese nivel. Entre años el líquido no se mueve: solo sube o baja el anillo, en vertical, sin saltos
 * laterales. `tipo`: 0 líquido o superficie, 1 vidrio, 2 marca de referencia. */
function probetasNivel(niveles, referencia, semilla) {
  const R = mulberry32(semilla), pos = new Float32Array(N * 3), liq = new Float32Array(N), tipo = new Uint8Array(N);
  for (let i = 0; i < N; i++) {
    const j = i % K, th = R() * Math.PI * 2, t = R(), u = R(), rr = Math.sqrt(R()), x0 = XS[j];
    let r = RADIO, y = SUELO + u * ALTO, l = 0;
    if (t < 0.04) { r = rr * RADIO; y = SUELO; tipo[i] = 1; }
    else if (t < 0.07) { r = RADIO * 1.05; y = SUELO + ALTO; tipo[i] = 1; }
    else if (t < 0.11) { r = RADIO * 1.03; y = SUELO + referencia[j] * ALTO + (rr - 0.5) * 0.012; tipo[i] = 2; }
    else if (t < 0.3) tipo[i] = 1;
    else if (u < niveles[j]) { r = rr * RADIO * 0.9; l = 1; }
    else { r = RADIO * (0.9 + 0.08 * rr); y = SUELO + niveles[j] * ALTO + (rr - 0.5) * 0.02; }
    pos.set([x0 + Math.cos(th) * r, y, Math.sin(th) * r], i * 3); liq[i] = l;
  }
  return { pos, liq, tipo };
}
// Escala común a las cuatro probetas y a todos los años: la llena es la mayor parte de toda la serie.
const MAXIMO = Math.max(...API.series.flatMap((se) => se.puntos.map((p) => p.valor)));
const NIVELES = PERS_E.map((per) => API.series.map((se) => punto(se, per).valor / MAXIMO * 0.94));
const FORMAS = NIVELES.map((niveles) => probetasNivel(niveles, NIVELES[0], 11));

const VERT = `
  uniform mat4 uProj, uMV; uniform float uT, uTime, uSize;
  attribute vec3 aFrom, aTo, aCol; attribute float aRnd; varying float vA, vLiq, vJ, vMov;
  void main(){
    // Capítulo: todas las partículas cambian a la vez, sin dispersión ni temblor por la velocidad del scroll
    float t = smoothstep(0.0, 1.0, uT);
    vec3 p = mix(aFrom, aTo, t);
    float liq = mix(aCol.x, aCol.y, t);
    p.x += sin(p.y * 2.3 + uTime * 0.5 + aRnd * 6.28) * 0.003;
    p.z += cos(p.x * 1.9 + uTime * 0.4 + aRnd * 3.1) * 0.003;
    vec4 mv = uMV * vec4(p, 1.0);
    gl_Position = uProj * mv;
    gl_PointSize = uSize * (0.55 + aRnd * 0.9) / -mv.z;
    vA = 0.45 + 0.55 * aRnd; vLiq = liq; vJ = aCol.z; vMov = step(0.001, distance(aFrom, aTo)) * sin(3.14159 * t);
  }`;
const FRAG = `
  precision highp float;
  uniform float uAlpha; uniform vec3 uC0, uC1, uC2, uC3; varying float vA, vLiq, vJ, vMov;
  void main(){
    float d = length(gl_PointCoord - 0.5); if (d > 0.5) discard;
    float s = smoothstep(0.5, 0.05, d);
    vec3 c = vJ < 0.17 ? uC0 : (vJ < 0.5 ? uC1 : (vJ < 0.84 ? uC2 : uC3));
    vec3 vidrio = vJ < -1.5 ? vec3(0.16, 0.13, 0.13) : vec3(0.36, 0.32, 0.32);
    // superficie: el color del tramo, más claro; brilla un poco mientras se mueve
    vec3 sup = mix(c, vec3(0.86, 0.46, 0.60), 0.25 + 0.4 * vMov);
    vec3 col = vJ < -0.5 ? vidrio : mix(sup, c, vLiq);
    float a = vJ < -1.5 ? 0.55 : (vJ < -0.5 ? 0.2 : mix(0.08 + 0.1 * vMov, vA, vLiq));
    gl_FragColor = vec4(col, s * a * uAlpha);
  }`;
const hex = (h) => [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16) / 255);

/** Modelo-vista: T · Rx · Ry · S y la cámara en z = DIST (como en la home). */
function matrizMV({ x, y = 0, rx, ry, s }) {
  const cx = Math.cos(rx), sx = Math.sin(rx), cy = Math.cos(ry), sy = Math.sin(ry);
  return new Float32Array([cy * s, sx * sy * s, -cx * sy * s, 0, 0, cx * s, sx * s, 0, sy * s, -sx * cy * s, cx * cy * s, 0, x, y, -DIST, 1]);
}
function matrizProy() {
  const f = 1 / Math.tan((FOV * Math.PI / 180) / 2), a = innerWidth / innerHeight, near = 0.1, far = 100;
  return new Float32Array([f / a, 0, 0, 0, 0, f, 0, 0, 0, 0, (far + near) / (near - far), -1, 0, 0, (2 * far * near) / (near - far), 0]);
}
/** Posición en pantalla de un punto del mundo (para las etiquetas HTML bajo cada probeta). */
function proyectar(p, mv) {
  const P = matrizProy(), e = [0, 1, 2, 3].map((r) => mv[r] * p[0] + mv[4 + r] * p[1] + mv[8 + r] * p[2] + mv[12 + r]);
  const c = [0, 1, 2, 3].map((r) => P[r] * e[0] + P[4 + r] * e[1] + P[8 + r] * e[2] + P[12 + r] * e[3]);
  return [(c[0] / c[3] * 0.5 + 0.5) * innerWidth, (0.5 - c[1] / c[3] * 0.5) * innerHeight];
}

function crearMotor(canvas, n) {
  const gl = canvas.getContext('webgl2', { alpha: true, antialias: false, premultipliedAlpha: true, powerPreference: 'high-performance' });
  if (!gl) return null;
  const sh = (tipo, src) => { const s = gl.createShader(tipo); gl.shaderSource(s, src); gl.compileShader(s);
    if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) throw new Error(gl.getShaderInfoLog(s)); return s; };
  const prog = gl.createProgram();
  gl.attachShader(prog, sh(gl.VERTEX_SHADER, VERT)); gl.attachShader(prog, sh(gl.FRAGMENT_SHADER, FRAG)); gl.linkProgram(prog);
  if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) throw new Error(gl.getProgramInfoLog(prog));
  gl.useProgram(prog);
  gl.bindVertexArray(gl.createVertexArray());
  const buffers = {}, u = {};
  ['uProj', 'uMV', 'uT', 'uTime', 'uSize', 'uAlpha', 'uC0', 'uC1', 'uC2', 'uC3'].forEach((k) => { u[k] = gl.getUniformLocation(prog, k); });
  const css = getComputedStyle(document.documentElement);
  ['uC0', 'uC1', 'uC2', 'uC3'].forEach((k, i) => gl.uniform3fv(u[k], hex(css.getPropertyValue(`--t${i}`).trim())));
  gl.disable(gl.DEPTH_TEST); gl.enable(gl.BLEND);
  gl.blendFuncSeparate(gl.SRC_ALPHA, gl.ONE_MINUS_SRC_ALPHA, gl.ONE, gl.ONE_MINUS_SRC_ALPHA);
  return {
    atributo(nombre, datos, tam) { const b = gl.createBuffer(), loc = gl.getAttribLocation(prog, nombre);
      gl.bindBuffer(gl.ARRAY_BUFFER, b); gl.bufferData(gl.ARRAY_BUFFER, datos, gl.DYNAMIC_DRAW);
      gl.enableVertexAttribArray(loc); gl.vertexAttribPointer(loc, tam, gl.FLOAT, false, 0, 0); buffers[nombre] = b; },
    subir(nombre, datos) { gl.bindBuffer(gl.ARRAY_BUFFER, buffers[nombre]); gl.bufferSubData(gl.ARRAY_BUFFER, 0, datos); },
    tamano() { const dpr = Math.min(devicePixelRatio, 2);
      canvas.width = Math.round(innerWidth * dpr); canvas.height = Math.round(innerHeight * dpr);
      gl.viewport(0, 0, canvas.width, canvas.height); gl.uniformMatrix4fv(u.uProj, false, matrizProy()); gl.uniform1f(u.uSize, 40 * dpr); },
    dibujar({ mv, t, tiempo, alfa }) {
      gl.uniformMatrix4fv(u.uMV, false, mv); gl.uniform1f(u.uT, t); gl.uniform1f(u.uTime, tiempo);
      gl.uniform1f(u.uAlpha, alfa);
      gl.clearColor(0, 0, 0, 0); gl.clear(gl.COLOR_BUFFER_BIT);
      if (alfa > 0.002) gl.drawArrays(gl.POINTS, 0, n);
    },
  };
}

/* ---------- scroll: apertura → escena fijada (2016 → 2025) → gráficos ---------- */
const secciones = [...document.querySelectorAll('[data-name]')];
$('rail').innerHTML = secciones.map((_, i) => `<span${i ? '' : ' class="on"'}></span>`).join('');
const railSpans = [...$('rail').children];
const esc0 = $('escena');
let activo = -1, idxAnio = 0;
function hudSeccion(y) {
  const medio = y + innerHeight * 0.5;
  let act = 0; secciones.forEach((s, i) => { if (s.offsetTop <= medio) act = i; });
  if (act !== activo) { activo = act; railSpans.forEach((s, j) => s.classList.toggle('on', j === act));
    $('hudIdx').textContent = `[${String(act + 1).padStart(2, '0')}/${String(secciones.length).padStart(2, '0')}]`; descifrar($('hudName'), secciones[act].dataset.name); }
  $('hudPct').textContent = String(Math.round(y / (document.documentElement.scrollHeight - innerHeight) * 100)).padStart(3, '0') + '%';
  const g = $('gancho'), osc = g.offsetTop <= y + 60 && g.offsetTop + g.offsetHeight > y + 60;
  document.body.classList.toggle('oscuro', osc);
  document.body.classList.toggle('lectura', y > esc0.offsetTop + esc0.offsetHeight - innerHeight * 0.4);
}

if (SIN_MOV) {
  addEventListener('scroll', () => hudSeccion(scrollY), { passive: true }); hudSeccion(scrollY);
} else {
  const motor = crearMotor($('gl'), N);
  const rnd = new Float32Array(N); { const R = mulberry32(7); for (let i = 0; i < N; i++) rnd[i] = R(); }
  const col = new Float32Array(N * 3);
  const colores = (a, b) => { for (let i = 0; i < N; i++) col.set([FORMAS[a].liq[i], FORMAS[b].liq[i], FORMAS[a].tipo[i] ? -FORMAS[a].tipo[i] : (i % K) / (K - 1)], i * 3); return col; };
  if (motor) {
    motor.atributo('aFrom', FORMAS[0].pos, 3); motor.atributo('aTo', FORMAS[1].pos, 3);
    motor.atributo('aCol', colores(0, 1), 3); motor.atributo('aRnd', rnd, 1);
    motor.tamano(); addEventListener('resize', () => motor.tamano());
  }
  let lenis = null; try { lenis = new Lenis({ lerp: 0.085, smoothWheel: true }); } catch (e) {}
  let raton = [0, 0]; addEventListener('pointermove', (e) => { raton = [e.clientX / innerWidth - 0.5, e.clientY / innerHeight - 0.5]; });
  let estado = 0, segmento = -1, pose = 0;
  function cuadro(t) {
    lenis?.raf(t);
    const y = scrollY;
    const ini = esc0.offsetTop, recorrido = esc0.offsetHeight - innerHeight;
    const entrada = suave(tramo(y, ini - innerHeight * 0.9, ini));          // apertura → escena
    const pe = clamp((y - ini) / recorrido);                                  // avance dentro de la escena
    const salida = tramo(y, ini + recorrido, ini + recorrido + innerHeight * 0.7);
    pose += (entrada - pose) * 0.12;
    // El scroll elige el año (entero); la escena se desliza hasta él y reposa: un paso visible por año
    const objetivo = Math.round(tramo(pe, 0.06, 0.86) * (PERS_E.length - 1));
    estado += (objetivo - estado) * 0.06;
    const i = Math.min(PERS_E.length - 2, Math.floor(estado)), f = estado - i;
    if (motor && i !== segmento) { segmento = i; motor.subir('aFrom', FORMAS[i].pos); motor.subir('aTo', FORMAS[i + 1].pos); motor.subir('aCol', colores(i, i + 1)); }
    if (objetivo !== idxAnio) { idxAnio = objetivo; mostrarAnio(objetivo); }
    const ancho = innerWidth > 860;
    // en móvil las cuatro probetas caben a lo ancho: escala según el ancho visible a la distancia de la cámara
    const anchoVisible = 2 * Math.tan((FOV / 2) * Math.PI / 180) * DIST * innerWidth / innerHeight;
    const cabe = anchoVisible * 0.86 / (2 * (XS[K - 1] + RADIO));
    const o = {
      x: ancho ? 2.1 + (1.15 - 2.1) * pose : 0,
      y: ancho ? 0 : -0.55 * pose - 0.2,
      s: ancho ? 0.74 + 0.3 * pose : Math.min(0.76, cabe),
      ry: (Math.sin(t / 5200) * 0.28 + raton[0] * 0.25) * (1 - pose * 0.7),
      rx: 0.1 + raton[1] * 0.1 * (1 - pose * 0.7),
    };
    const mv = matrizMV(o);
    const alfa = (ancho ? 1 : 0.16 + 0.84 * pose) * (1 - salida);
    motor?.dibujar({ mv, t: f, tiempo: t / 1000, alfa });
    // etiquetas HTML bajo cada probeta, en la posición proyectada
    const vis = pose * (1 - salida);
    etiquetas.style.opacity = vis;
    if (vis > 0.01) etiquetas.querySelectorAll('.et').forEach((el, j) => { const [sx, sy] = proyectar([XS[j], SUELO - 0.14, 0], mv); el.style.left = `${sx}px`; el.style.top = `${sy}px`; });
    hudSeccion(y);
    requestAnimationFrame(cuadro);
  }
  requestAnimationFrame(cuadro);
}
</script>
</body>
</html>
