---
// Los datos salen del modelo de evidencia de chiq.es (datos/evidencia → web/src/data/generado), sin escribir cifras a mano.
import capitulo from '../data/capitulos/e2-brecha.json';
import lineas from '../data/graficos/brecha-litros-persona-menos35.json';
import apiladas from '../data/graficos/cuota-volumen-edad.json';

const DATOS = {
  capitulo,
  graficos: { 'brecha-litros-persona-menos35': lineas, 'cuota-volumen-edad': apiladas },
  generado_por: 'chiq.es · modelo de evidencia, exportación v2',
};
const DATOS_JSON = JSON.stringify(DATOS).replace(/</g, '\\u003c');
---
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>El mercado en datos · Bodega Ejemplo · demo de chiq.es</title>
<meta name="robots" content="noindex, nofollow">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter+Tight:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style is:global>
:root{--bg:#ebe8e3;--ink:#141011;--wine:#6e1432;--rosa:#a3456a;--mute:#857d78;--gris-texto:#6b635f;--line:rgba(20,16,17,.14);--hud:#6b635f;
  --t0:#33081a;--t1:#7a1a3e;--t2:#b35a80;--t3:#d493ad;--nota:#2f5bd3}
*{box-sizing:border-box;margin:0;padding:0}
html{background:var(--bg)}
body{color:var(--ink);font-family:'Inter Tight',system-ui,sans-serif;-webkit-font-smoothing:antialiased;overflow-x:hidden}
.mono{font-family:'JetBrains Mono',ui-monospace,monospace;font-size:11px;letter-spacing:.12em;text-transform:uppercase}
canvas#gl{position:fixed;inset:0;width:100vw;height:100vh;z-index:3;pointer-events:none}
.grain{position:fixed;inset:-50%;width:200%;height:200%;z-index:5;pointer-events:none;opacity:.07;
  background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='180' height='180'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='3' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
  animation:grain .9s steps(6) infinite}
@keyframes grain{0%{transform:translate(0,0)}20%{transform:translate(-3%,2%)}40%{transform:translate(2%,-3%)}60%{transform:translate(-2%,-1%)}80%{transform:translate(3%,3%)}100%{transform:translate(0,0)}}
/* carcasa (igual que la home) */
header{position:fixed;top:0;left:0;right:0;z-index:20;display:flex;align-items:center;justify-content:space-between;padding:22px clamp(18px,3vw,40px);transition:color .6s}
.logo{font-family:'Instrument Serif',serif;font-size:32px;letter-spacing:-.02em;color:var(--ink);text-decoration:none;line-height:1}
nav{display:flex;gap:26px;align-items:center}
nav a{color:var(--ink);text-decoration:none;font-size:14px;position:relative}
nav a:not(.btn)::after{content:'';position:absolute;left:0;right:100%;bottom:-3px;height:1px;background:currentColor;transition:right .45s cubic-bezier(.7,0,.2,1)}
nav a:not(.btn):hover::after,nav a[aria-current]::after{right:0}
.btn{border:1px solid var(--ink);border-radius:999px;padding:9px 18px;font-size:13px}
.btn:hover{background:var(--ink);color:var(--bg)}
.burger{width:42px;height:42px;border-radius:50%;border:1px solid var(--line);display:grid;place-items:center;cursor:pointer;background:transparent}
.burger i{display:block;width:14px;height:1px;background:var(--ink);box-shadow:0 5px 0 var(--ink);transform:translateY(-2px)}
header::before{content:'';position:absolute;inset:0;background:rgba(235,232,227,.8);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border-bottom:1px solid var(--line);opacity:0;transition:opacity .5s;z-index:-1}
/* en lectura (tras la escena) la cabecera se vuelve opaca y el HUD de arriba se retira: el texto no pasa por debajo */
body.lectura header::before{opacity:1}
body.lectura header{padding-top:14px;padding-bottom:14px}
.hud.tl,.hud.tr{transition:opacity .5s,color .6s}
body.lectura .hud.tl,body.lectura .hud.tr{opacity:0}
body.oscuro header::before{background:rgba(20,16,17,.8);border-color:rgba(244,239,232,.12)}
body.oscuro header{--ink:#f4efe8;--line:rgba(244,239,232,.3)}
body.oscuro .hud{--hud:rgba(244,239,232,.72);--ink:#f4efe8}
.hud{position:fixed;z-index:15;color:var(--hud);pointer-events:none;line-height:1.7;transition:color .6s}
.hud.tl{top:90px;left:clamp(18px,3vw,40px)}.hud.tr{top:90px;right:clamp(18px,3vw,40px);text-align:right}
.hud.bl{bottom:26px;left:clamp(18px,3vw,40px)}.hud.br{bottom:26px;right:clamp(18px,3vw,40px);text-align:right}
.hud .ink{color:var(--ink)}
.rail{position:fixed;z-index:15;right:clamp(18px,3vw,40px);top:50%;transform:translateY(-50%);display:flex;flex-direction:column;align-items:flex-end;gap:12px}
.rail span{width:16px;height:1px;background:var(--line);transition:width .5s cubic-bezier(.16,.84,.24,1),background .5s}
.rail span.on{width:40px;background:var(--rosa)}
main{position:relative;z-index:10}
.w{display:inline-block;overflow:hidden;vertical-align:top;padding-bottom:.08em;margin-bottom:-.08em}
.w>*{display:inline-block;transform:translateY(110%) rotate(4deg);transform-origin:left bottom;transition:transform 1.1s cubic-bezier(.16,.84,.24,1)}
.in .w>*{transform:none}
.fade{opacity:0;transform:translateY(22px);transition:opacity 1.1s .35s,transform 1.1s .35s cubic-bezier(.16,.84,.24,1)}
.in .fade{opacity:1;transform:none}
.pad{padding:0 clamp(18px,7vw,120px)}
.estado{display:inline-flex;align-items:center;gap:6px;border:1px solid currentColor;border-radius:999px;padding:3px 9px;color:var(--wine);white-space:nowrap}
/* apertura */
#apertura{position:relative;min-height:100vh;display:flex;flex-direction:column;justify-content:center;padding-top:140px;padding-bottom:110px}
#apertura .caja{max-width:min(760px,58vw)}
.kicker{color:var(--gris-texto);display:flex;gap:14px;align-items:center}
.kicker b{color:var(--wine);font-weight:500}
.kicker::after{content:'';width:64px;height:1px;background:var(--line)}
#apertura h1{font-family:'Instrument Serif',serif;font-weight:400;font-size:clamp(60px,9.4vw,156px);line-height:.9;letter-spacing:-.035em;margin:26px 0 34px}
#apertura h1 em,h2 em,.gancho-t em{font-style:italic;color:var(--wine)}
.respuesta{font-family:'Instrument Serif',serif;font-size:clamp(24px,2.3vw,34px);line-height:1.18;letter-spacing:-.01em;max-width:30ch}
.linea-respuesta{margin-top:22px;color:var(--gris-texto);display:flex;flex-wrap:wrap;gap:10px 14px;align-items:center;line-height:1.6}
.linea-respuesta a{color:var(--ink)}
.cue{position:absolute;bottom:36px;left:50%;transform:translateX(-50%);color:var(--gris-texto);text-align:center}
.cue::after{content:'';display:block;width:1px;height:44px;background:var(--ink);margin:12px auto 0;animation:cue 2.2s cubic-bezier(.7,0,.2,1) infinite}
@keyframes cue{0%{transform:scaleY(0);transform-origin:top}45%{transform:scaleY(1);transform-origin:top}55%{transform:scaleY(1);transform-origin:bottom}100%{transform:scaleY(0);transform-origin:bottom}}
/* escena fijada */
#escena{height:560vh;position:relative}
#escena .pin{position:sticky;top:0;height:100vh;overflow:hidden}
.anio-caja{position:absolute;left:clamp(18px,7vw,120px);top:50%;transform:translateY(-50%);max-width:min(460px,34vw)}
.anio-caja .pregunta{color:var(--gris-texto);line-height:1.7;max-width:46ch}
.anio{font-family:'Instrument Serif',serif;font-size:clamp(110px,13vw,210px);line-height:.85;letter-spacing:-.04em;margin:18px 0 20px;font-variant-numeric:lining-nums}
.anio em{font-style:italic;color:var(--wine)}
.rupturas-escena{list-style:none;display:grid;gap:6px;min-height:40px}
.rupturas-escena li{color:var(--gris-texto);line-height:1.5;opacity:0;transform:translateY(8px);transition:opacity .6s,transform .6s cubic-bezier(.16,.84,.24,1)}
.rupturas-escena li.si{opacity:1;transform:none}
.rupturas-escena li b{color:var(--wine);font-weight:500}
#etiquetas{position:fixed;inset:0;z-index:12;pointer-events:none;opacity:0}
#etiquetas .et{position:absolute;transform:translate(-50%,0);text-align:center;width:120px}
#etiquetas .et .v{font-family:'Instrument Serif',serif;font-size:clamp(26px,2.6vw,40px);line-height:1;letter-spacing:-.02em;display:block;font-variant-numeric:tabular-nums}
#etiquetas .et .n{color:var(--gris-texto);display:block;margin-top:8px;line-height:1.5}
#etiquetas .et i{display:inline-block;width:10px;height:10px;border-radius:50%;margin-right:6px;vertical-align:-1px}
#etiquetas .et .d{display:block;margin-top:6px;color:var(--gris-texto);font-size:10px;opacity:.8}
.sin-movimiento #etiquetas .et .d{display:none}
.leyenda-escena{color:var(--gris-texto);margin-top:14px}
.sin-movimiento .leyenda-escena{display:none}
.leyenda-escena .marca{display:inline-block;width:22px;height:0;border-top:2px dotted #2a2122;margin-right:8px;vertical-align:3px}
.decorativa{position:absolute;right:clamp(18px,3vw,40px);bottom:clamp(70px,11vh,120px);color:var(--gris-texto);max-width:30ch;text-align:right;line-height:1.6}
/* gráficos */
section.bloque{padding-top:120px;padding-bottom:40px}
.n{display:flex;gap:14px;align-items:center;color:var(--gris-texto)}
.n b{color:var(--wine);font-weight:500}
.n::after{content:'';width:64px;height:1px;background:var(--line)}
h2{font-family:'Instrument Serif',serif;font-weight:400;font-size:clamp(34px,3.7vw,58px);line-height:1;letter-spacing:-.025em;margin:22px 0 22px;max-width:24ch}
.afirmacion{font-size:clamp(17px,1.3vw,20px);line-height:1.55;max-width:60ch;color:#2b2425}
.afirmacion .estado{margin-left:8px;vertical-align:1px}
.panel{margin-top:34px;border-radius:20px;background:rgba(255,255,255,.42);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border:1px solid rgba(255,255,255,.75);box-shadow:0 40px 80px -40px rgba(20,16,17,.25);padding:clamp(16px,2.4vw,32px)}
.leyenda{display:flex;flex-wrap:wrap;gap:8px 22px;font-size:14px;color:#2b2425;margin-bottom:10px;list-style:none}
.leyenda li{display:flex;align-items:center;gap:8px}
.leyenda .m{display:inline-block;width:18px;height:2px;border-radius:2px}
.leyenda .m.b{width:12px;height:12px;border-radius:3px}
.leyenda .m.h{width:10px;height:10px;border-radius:50%;background:transparent!important;border:1.5px solid var(--gris-texto)}
.leyenda .m.p{height:0;border-top:2px dotted var(--gris-texto);background:transparent!important}
.leyenda .ast{font-family:'JetBrains Mono',monospace;color:var(--wine);width:18px;text-align:center}
.lienzo{position:relative}
.lienzo svg{display:block;width:100%;height:auto;overflow:visible}
.lienzo svg text{font-family:'Inter Tight',sans-serif}
.lienzo .eje text{font-family:'JetBrains Mono',monospace;font-size:11px;fill:var(--gris-texto);letter-spacing:.04em}
.lienzo .valor{font-size:14px;font-weight:500;fill:var(--ink);font-variant-numeric:tabular-nums}
.lienzo .rup text{font-family:'JetBrains Mono',monospace;font-size:10px;fill:var(--gris-texto);letter-spacing:.06em;text-transform:uppercase}
.tip{position:absolute;pointer-events:none;background:#141011;color:#f4efe8;border-radius:10px;padding:10px 12px;font-size:13px;line-height:1.5;min-width:180px;opacity:0;transition:opacity .15s;z-index:4;box-shadow:0 12px 30px -12px rgba(0,0,0,.5)}
.tip b{font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.1em;font-weight:500;display:block;margin-bottom:4px;color:#d8cfc8}
.tip .f{display:flex;justify-content:space-between;gap:14px}
.tip .f span:first-child{display:flex;align-items:center;gap:6px;color:#d8cfc8}
.tip i{display:inline-block;width:8px;height:8px;border-radius:50%}
.tip small{display:block;color:#b8aea7;font-size:12px}
figcaption{margin-top:18px;color:var(--gris-texto);font-size:14px;line-height:1.6}
figcaption .hud-f{color:var(--gris-texto)}
.rupturas{margin:8px 0 0 18px}
.rupturas .magnitud{color:#3a3334}
details{margin-top:14px;border-top:1px solid var(--line);padding-top:12px;font-size:14px}
summary{cursor:pointer;color:var(--gris-texto);list-style:none;display:flex;align-items:center;gap:10px}
summary::before{content:'+';font-family:'JetBrains Mono',monospace;color:var(--wine);width:12px}
details[open] summary::before{content:'−'}
table{border-collapse:collapse;margin-top:12px;font-size:14px;width:100%;font-variant-numeric:tabular-nums}
caption{text-align:left;color:var(--gris-texto);font-size:13px;margin-bottom:8px}
th,td{padding:7px 10px;border-bottom:1px solid var(--line);text-align:right;vertical-align:top}
th:first-child,td:first-child{text-align:left}
thead th{font-weight:500;color:var(--gris-texto);font-size:13px}
td small{display:block;color:var(--gris-texto);font-size:12px}
.tabla-scroll{overflow-x:auto}
.procedencia dl{display:grid;grid-template-columns:minmax(0,max-content) minmax(0,1fr);gap:6px 16px;margin-top:12px}
.procedencia dt{color:var(--gris-texto)}
.procedencia dd{overflow-wrap:anywhere}
.procedencia code{font-family:'JetBrains Mono',monospace;font-size:12px}
.procedencia ul{margin:0;padding-left:16px}
.ficha{display:inline-flex;align-items:center;gap:12px;margin-top:18px;color:var(--ink);text-decoration:none;font-size:15px}
.ficha .ar,.cta .ar{width:40px;height:40px;border-radius:50%;border:1px solid currentColor;display:grid;place-items:center;transition:all .5s cubic-bezier(.7,0,.2,1)}
.ficha:hover .ar{background:var(--wine);border-color:var(--wine);color:#fff;transform:rotate(-45deg)}
/* cautelas */
#cautelas{padding-top:110px;padding-bottom:120px}
#cautelas ul{list-style:none;margin-top:10px;max-width:78ch;counter-reset:c}
#cautelas li{counter-increment:c;display:grid;grid-template-columns:48px 1fr;gap:12px;padding:16px 0;border-top:1px solid var(--line);font-size:16px;line-height:1.55;color:#2b2425}
#cautelas li::before{content:counter(c,decimal-leading-zero);font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.12em;color:var(--wine);padding-top:4px}
#cautelas li.sin-control{color:var(--wine)}
/* gancho */
#gancho{position:relative;background:#141011;color:#f4efe8;padding-top:clamp(110px,16vh,180px);padding-bottom:clamp(110px,16vh,180px)}
#gancho .n{color:#a59c96}#gancho .n::after{background:rgba(244,239,232,.25)}
.gancho-t{font-family:'Instrument Serif',serif;font-size:clamp(44px,6.6vw,108px);line-height:.95;letter-spacing:-.03em;max-width:15ch;margin:26px 0 40px}
#gancho .gancho-t em{color:#e59ab7}
.cta{display:inline-flex;align-items:center;gap:16px;color:#f4efe8;text-decoration:none;font-size:17px}
.cta .ar{width:58px;height:58px;font-size:18px;border-color:#f4efe8}
.cta:hover .ar{background:#e59ab7;border-color:#e59ab7;color:#141011;transform:rotate(-45deg)}
.siguiente{display:flex;flex-wrap:wrap;justify-content:space-between;gap:16px;padding-top:40px;padding-bottom:40px;font-size:15px;border-top:1px solid var(--line)}
.siguiente a{color:var(--ink)}
footer{position:relative;z-index:10;padding:120px clamp(18px,7vw,120px) 40px;display:grid;gap:56px;background:var(--bg)}
footer .big{font-family:'Instrument Serif',serif;font-size:clamp(40px,6vw,96px);letter-spacing:-.03em;line-height:.95;max-width:14ch}
footer .big em{font-style:italic;color:var(--wine)}
footer .cols{display:flex;flex-wrap:wrap;gap:40px 80px;justify-content:space-between;border-top:1px solid var(--line);padding-top:28px;color:var(--gris-texto)}
footer .cols a,footer .cols button{color:var(--ink);text-decoration:none;display:block;font-size:14px;line-height:2;background:none;border:0;font-family:inherit;cursor:pointer;text-align:left}
#menu{position:fixed;inset:0;z-index:40;background:#141011;color:#f4efe8;clip-path:circle(0% at calc(100% - 62px) 43px);transition:clip-path 1s cubic-bezier(.7,0,.2,1);display:flex;flex-direction:column;justify-content:center;padding:0 clamp(18px,7vw,120px)}
#menu.open{clip-path:circle(160% at calc(100% - 62px) 43px)}
#menu a{font-family:'Instrument Serif',serif;font-size:clamp(42px,6.4vw,96px);color:#f4efe8;text-decoration:none;line-height:1.08;display:flex;gap:26px;align-items:baseline;transition:color .3s,padding .5s cubic-bezier(.16,.84,.24,1)}
#menu a:hover{color:#d88aa6;padding-left:18px}
#menu a small{font-family:'JetBrains Mono',monospace;font-size:12px;color:#8d8580}
#menu .seal{position:absolute;bottom:32px;left:clamp(18px,7vw,120px);color:#8d8580}
#menu .close{position:absolute;top:22px;right:clamp(18px,3vw,40px);color:#f4efe8;background:none;border:1px solid #4a4244;border-radius:999px;padding:10px 18px;cursor:pointer}
/* notas de maqueta: no son diseño, son preguntas para el autor */
.nota-m{display:none;margin-top:14px;border:1px dashed var(--nota);color:var(--nota);border-radius:10px;padding:10px 12px;font-family:'JetBrains Mono',monospace;font-size:11.5px;line-height:1.55;max-width:62ch;background:rgba(47,91,211,.05);text-transform:none;letter-spacing:0}
.nota-m b{font-weight:500}
body.notas .nota-m{display:block}
.nota-flot{position:absolute;z-index:14}
#conmutador{position:fixed;z-index:30;left:50%;bottom:22px;transform:translateX(-50%);background:#fff;border:1px dashed var(--nota);color:var(--nota);border-radius:999px;padding:9px 16px;cursor:pointer}
/* sin movimiento (nivel de la spec §4.4.6): texto y cifras, sin motor ni scroll fijado */
.sin-movimiento #escena{height:auto;padding:120px 0 40px}
.sin-movimiento #escena .pin{position:relative;height:auto;overflow:visible}
.sin-movimiento .anio-caja{position:relative;left:auto;top:auto;transform:none;max-width:none;padding:0 clamp(18px,7vw,120px)}
.sin-movimiento #etiquetas{position:relative;inset:auto;opacity:1;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;padding:30px clamp(18px,7vw,120px)}
.sin-movimiento #etiquetas .et{position:relative;transform:none;width:auto;left:auto!important;top:auto!important;text-align:left}
.sin-movimiento .rupturas-escena li{opacity:1;transform:none}
.sin-movimiento .decorativa,.sin-movimiento .cue{display:none}
@media (max-width:860px){
  nav a{display:none}.hud.tr,.hud.tl,.rail{display:none}
  .kicker::after{display:none}
  #apertura .caja{max-width:none}
  .anio-caja{top:96px;transform:none;max-width:none;right:clamp(18px,7vw,120px)}
  .anio{font-size:96px;margin:10px 0 12px}
  .anio-caja .pregunta{font-size:10px}
  .rupturas-escena{min-height:0}
  .leyenda-escena{margin-top:8px}
  #etiquetas .et .d{font-size:9px;letter-spacing:.02em;white-space:nowrap}
  #etiquetas .et{width:84px}#etiquetas .et .n{font-size:9px;letter-spacing:.06em}
  .decorativa{display:none}
  .sin-movimiento #etiquetas{grid-template-columns:repeat(2,minmax(0,1fr))}
}
@media (prefers-reduced-motion:reduce){.grain{animation:none}.w>*{transform:none;transition:none}.fade{opacity:1;transform:none;transition:none}}

footer .pie-t{display:block;font-size:14px;line-height:1.5;opacity:.75;max-width:30ch}
#conmutador{display:none!important}
</style>
</head>
<body>
<canvas id="gl" aria-hidden="true"></canvas>
<div class="grain" aria-hidden="true"></div>

<header>
  <a class="logo" href="/">Bodega Ejemplo</a>
  <nav aria-label="Principal">
    <a href="/">Historia</a><a href="/mercado/" aria-current="page">El mercado en datos</a><a href="/como-esta-hecha/">Cómo está hecha</a>
    <button class="burger" id="burger" aria-label="Abrir menú"><i></i></button>
  </nav>
</header>
<div class="hud tl mono"><span class="ink" id="hudCap"></span><br><span id="hudFuente"></span></div>
<div class="hud tr mono">Datos actualizados<br><span class="ink" id="hudAct"></span></div>
<div class="hud bl mono"><span id="hudIdx" class="ink">[01/06]</span>&nbsp; <span id="hudName">RESPUESTA</span></div>
<div class="hud br mono">Scroll <span id="hudPct" class="ink">000%</span></div>
<div class="rail" id="rail" aria-hidden="true"></div>
<button id="conmutador" class="mono" type="button" aria-pressed="false">Notas de maqueta · no</button>

<main>
  <article>
    <section id="apertura" class="pad" data-name="RESPUESTA">
      <div class="caja">
        <p class="kicker mono fade"><b>Obs_01</b> <span id="kicker"></span></p>
        <h1 class="split" id="titulo"></h1>
